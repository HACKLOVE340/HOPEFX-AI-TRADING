# Operational config files — contain strategy internals and may hold credentials.
# These are generated/edited at deploy time; never commit live values.
# Copy from *.example templates and fill in locally.
WORDMAP.json
!WORDMAP.json.example
# prop_firm_mode.json is committed with placeholder credentials for CI.
# Override locally with real credentials — do NOT commit real tokens.
!prop_firm_mode.json.example

# ML trained model artifacts (not source code)
/models/
# Binary model artifacts — regenerated by training; never commit
ml/saved_models/*.pkl
!ml/saved_models/current.pkl
!ml/saved_models/advanced_oos.pkl
!ml/saved_models/hybrid_meta.pkl
!ml/saved_models/rf_macro.pkl
