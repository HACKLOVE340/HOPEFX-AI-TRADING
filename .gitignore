# Kill switch flag — runtime state, never commit
kill_switch.flag

# FIX session config with live credentials — never commit
fix.cfg.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/

# MkDocs generated site (built by CI, not committed)
site/

# Frontend build output and dependencies
frontend/node_modules/
static/

# Keep the built dashboard so the server can serve it without a build step
!dashboard/dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Node
node_modules/
dashboard/node_modules/
# Ignore root-level lockfile (Python project root) but track frontend lockfile for CI caching
/package-lock.json
dashboard/package-lock.json
# Explicitly track frontend lockfile
!frontend/package-lock.json

# Virtual environments
venv/
env/
ENV/
.venv/
.env
.venv
env.bak/
venv.bak/

