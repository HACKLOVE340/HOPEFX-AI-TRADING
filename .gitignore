.env
.env.local
.env.*.local
!.env.example

# Database
*.db
*.sqlite
*.sqlite3
# data/ — source package, not ignored
# /data/  # uncomment to ignore data download cache
*.dump

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ML trained model artifacts (not source code)
/models/
# Binary model artifacts — regenerated by training; never commit
ml/saved_models/*.pkl
!ml/saved_models/current.pkl
ml/saved_models/*.joblib
# model_checksums.json is machine-generated at deploy time
ml/saved_models/model_checksums.json
# registry.json is tracked in git as the seed manifest; updated by ModelRegistry at runtime
*.h5
*.pt
*.pth
mlruns/
mlflow.db

# Redis
*.rdb
dump.rdb

