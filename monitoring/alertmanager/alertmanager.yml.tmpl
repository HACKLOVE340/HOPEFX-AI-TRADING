# monitoring/alertmanager/alertmanager.yml
# Alertmanager production configuration for HopeFX.
#
# Routing summary
# ---------------
#   critical → Telegram (immediate) + email + PagerDuty
#   warning  → email only (5 min grouping)
#   default  → email (10 min grouping)
#
# When real fills flow and a drawdown or P&L reconciliation breach fires,
# the on-call page goes out via Telegram instantly (group_wait: 0s).
#
# Optional environment variables (set in .env, never committed). A channel
# whose variables are unset is omitted from the rendered config entirely — see
# the @if blocks below and the note on conditional blocks at the end of this
# header.
#
#   ALERTMANAGER_TELEGRAM_BOT_TOKEN  — Telegram bot token from @BotFather
#   ALERTMANAGER_TELEGRAM_CHAT_ID    — Telegram chat/channel ID (non-zero integer)
#   ALERTMANAGER_SMTP_FROM           — sender address
#   ALERTMANAGER_SMTP_TO             — recipient address
#   ALERTMANAGER_SMTP_HOST           — SMTP relay host:port (e.g. smtp.sendgrid.net:587)
#   ALERTMANAGER_SMTP_USERNAME       — SMTP auth username
#   ALERTMANAGER_SMTP_PASSWORD       — SMTP auth password
#   ALERTMANAGER_PAGERDUTY_KEY       — PagerDuty Events API v2 integration key
#
# ── Why the @if blocks exist ─────────────────────────────────────────────────
#
# This file used to declare every receiver unconditionally, with empty strings
# where the secrets go. Alertmanager rejects that outright, so the container
# never started — not with the shipped defaults, and not with every documented
# variable set either, because three of the keys did not exist in the schema.
# Verified against prom/alertmanager v0.27.0 `amtool check-config`:
#
#   routing_key: ''            → missing service or routing key in PagerDuty config
#   bot_token: ''              → missing bot_token or bot_token_file on telegram_config
#   chat_id: 0                 → missing chat_id on telegram_config
#   to: ''                     → missing to address in email config
#   email_configs.subject      → field subject not found in type config.plain
#   email_configs.body         → field body not found in type config.plain
#   telegram_configs.tls_config→ field tls_config not found in type config.plain
#
# The last three are not configuration mistakes an operator could fix: the
# correct spellings are `headers.subject`, `text`, and `http_config.tls_config`.
# So `alertmanager` sat in a restart loop while Prometheus scraped happily and
# every rule in monitoring/rules — drawdown breach, circuit breaker open, P&L
# reconciliation failure — fired into nothing.
#
# Blocks between `# @if VAR` and `# @endif` are kept only when VAR is set and
# non-empty in the entrypoint's environment; otherwise they are deleted before
# alertmanager ever sees the file. A receiver with no integrations is valid, so
# the stack starts with zero secrets configured. entrypoint.sh prints exactly
# which channels are live at boot, because a config that silently notifies
# nobody is the failure mode this whole file is guarding against.

global:
  resolve_timeout: 5m
  smtp_smarthost: '${ALERTMANAGER_SMTP_HOST:-localhost:587}'
  smtp_from: '${ALERTMANAGER_SMTP_FROM:-alerts@hopefx.io}'
  smtp_auth_username: '${ALERTMANAGER_SMTP_USERNAME:-}'
  smtp_auth_password: '${ALERTMANAGER_SMTP_PASSWORD:-}'
  smtp_require_tls: true

templates:
  - '/etc/alertmanager/templates/*.tmpl'

# ── Routing tree ──────────────────────────────────────────────────────────────
#
# All alerts enter at the root and are matched top-to-bottom.
# The first matching route wins.

route:
  group_by: ['alertname', 'severity']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: 'email-default'

  routes:
    # Critical alerts: Telegram + email + PagerDuty, no grouping delay.
    # Covers: drawdown breach, circuit breaker open, API down,
    #         P&L reconciliation gate failed, P&L divergence over 5 USD.
    - matchers:
        - severity = critical
      receiver: 'critical'
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1h
      continue: false

    # Warning alerts: email only, 5 min grouping.
    # Covers: high latency, Redis/DB pressure, P&L divergence 1-5 USD,
    #         reconciliation stale.
    - matchers:
        - severity = warning
      receiver: 'email-default'
      group_wait: 5m
      group_interval: 10m
      repeat_interval: 6h
      continue: false

# ── Receivers ─────────────────────────────────────────────────────────────────

receivers:
  # critical: Telegram (immediate on-call page) + email + optional PagerDuty
  - name: 'critical'
    # @if HOPEFX_AM_TELEGRAM_ENABLED
    telegram_configs:
      - bot_token: '${ALERTMANAGER_TELEGRAM_BOT_TOKEN}'
        # chat_id must be a non-zero integer — obtain via @userinfobot or the
        # Telegram Bot API getUpdates endpoint.
        chat_id: ${ALERTMANAGER_TELEGRAM_CHAT_ID}
        message: |
          HOPEFX CRITICAL ALERT
          Alert: {{ .GroupLabels.alertname }}
          {{ range .Alerts }}
          Summary: {{ .Annotations.summary }}
          Detail: {{ .Annotations.description }}
          Started: {{ .StartsAt.Format "2006-01-02 15:04:05 UTC" }}
          {{ end }}
        parse_mode: 'Markdown'
        send_resolved: true
        http_config:
          tls_config:
            insecure_skip_verify: false
    # @endif

    # @if HOPEFX_AM_EMAIL_ENABLED
    email_configs:
      - to: '${ALERTMANAGER_SMTP_TO}'
        headers:
          subject: '[CRITICAL] HopeFX: {{ .GroupLabels.alertname }}'
          X-HopeFX-Severity: critical
        text: |
          CRITICAL alert fired on HopeFX production.

          {{ range .Alerts }}
          Alert:       {{ .Labels.alertname }}
          Summary:     {{ .Annotations.summary }}
          Description: {{ .Annotations.description }}
          Started:     {{ .StartsAt.Format "2006-01-02 15:04:05 UTC" }}
          {{ end }}
        send_resolved: true
    # @endif

    # @if HOPEFX_AM_PAGERDUTY_ENABLED
    pagerduty_configs:
      - routing_key: '${ALERTMANAGER_PAGERDUTY_KEY}'
        description: '{{ .GroupLabels.alertname }}: {{ range .Alerts }}{{ .Annotations.summary }}{{ end }}'
        severity: 'critical'
        send_resolved: true
        details:
          alert: '{{ .GroupLabels.alertname }}'
          environment: 'production'
          service: 'hopefx-trading'
    # @endif

  # email-default: warning and default alerts
  - name: 'email-default'
    # @if HOPEFX_AM_EMAIL_ENABLED
    email_configs:
      - to: '${ALERTMANAGER_SMTP_TO}'
        headers:
          subject: '[{{ .Status | toUpper }}] HopeFX: {{ .GroupLabels.alertname }}'
          X-HopeFX-Severity: '{{ .CommonLabels.severity }}'
        text: |
          {{ .Status | toUpper }} alert on HopeFX production.

          {{ range .Alerts }}
          Alert:       {{ .Labels.alertname }}
          Severity:    {{ .Labels.severity }}
          Summary:     {{ .Annotations.summary }}
          Description: {{ .Annotations.description }}
          Started:     {{ .StartsAt.Format "2006-01-02 15:04:05 UTC" }}
          {{ end }}
        send_resolved: true
    # @endif

# ── Inhibition rules ──────────────────────────────────────────────────────────
#
# Suppress lower-severity alerts when a higher-severity alert is already
# firing for the same alertname, to reduce noise during outages.

inhibit_rules:
  # Suppress warning when critical is firing for the same alert.
  - source_matchers:
      - severity = critical
    target_matchers:
      - severity = warning
    equal: ['alertname']

  # When the API is down, suppress all other alerts — they are likely
  # caused by the same outage and would create noise.
  - source_matchers:
      - alertname = HopeFXAPIDown
    target_matchers:
      - severity =~ "warning|critical"
    equal: []

  # When the circuit breaker is open (trading halted), suppress P&L
  # divergence warnings — fills cannot be recorded while halted.
  - source_matchers:
      - alertname = HopeFXCircuitBreakerOpen
    target_matchers:
      - alertname =~ "HopeFXPnLDivergence.*|HopeFXPnLReconciliation.*"
    equal: []
