# HOPEFX AI Trading — Nginx reverse proxy
#
# Domain is read from the HOPEFX_DOMAIN environment variable at container
# start via envsubst (see nginx/entrypoint.sh).  Set it in docker-compose.yml
# or your deployment environment:
#
#   HOPEFX_DOMAIN=hopefx.io
#
# Certbot will auto-update the ssl_certificate paths once you run:
#   certbot --nginx -d ${HOPEFX_DOMAIN} -d www.${HOPEFX_DOMAIN}

worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid       /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # ── Logging ───────────────────────────────────────────────────────────────
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent"';
    access_log /var/log/nginx/access.log main;

    # ── Performance ───────────────────────────────────────────────────────────
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout 65;
    client_max_body_size 10M;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json
               application/javascript application/xml+rss
               application/atom+xml image/svg+xml;

    # ── Rate limiting ─────────────────────────────────────────────────────────
    # Auth endpoints: 10 req/min per IP
    limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
    # API endpoints: 60 req/min per IP
    limit_req_zone $binary_remote_addr zone=api:10m  rate=60r/m;

    # ── Upstream ──────────────────────────────────────────────────────────────
    # Use the Docker Compose service name — 127.0.0.1 inside the nginx
    # container resolves to nginx itself, not the app container.
    upstream hopefx_backend {
        server app:8000;
        keepalive 32;
    }

    # ── HTTP → HTTPS redirect ─────────────────────────────────────────────────
    server {
        listen 80;
        listen [::]:80;
        server_name ${HOPEFX_DOMAIN} www.${HOPEFX_DOMAIN};

        # Allow Let's Encrypt ACME challenge
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # ── HTTPS main server ─────────────────────────────────────────────────────
    server {
        listen 443 ssl http2;
        listen [::]:443 ssl http2;
        server_name ${HOPEFX_DOMAIN} www.${HOPEFX_DOMAIN};

        # SSL — managed by Certbot
        ssl_certificate     /etc/letsencrypt/live/${HOPEFX_DOMAIN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${HOPEFX_DOMAIN}/privkey.pem;
        ssl_session_cache   shared:SSL:10m;
        ssl_session_timeout 1d;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers off;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

        # ── Security headers ──────────────────────────────────────────────────
        add_header X-Frame-Options           "SAMEORIGIN"    always;
        add_header X-Content-Type-Options    "nosniff"       always;
        add_header X-XSS-Protection          "1; mode=block" always;
        add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy        "geolocation=(), microphone=(), camera=()" always;
        # connect-src covers REST (/api/*), both WebSocket endpoints
        # (/ws/live and /ws/nuclear), and QR code generation (2FA setup).
        # worker-src blob: is required by lightweight-charts web workers.
        add_header Content-Security-Policy
            "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://api.qrserver.com; connect-src 'self' wss://${HOPEFX_DOMAIN} https://api.qrserver.com; font-src 'self'; worker-src 'self' blob:;"
            always;

        # ── Auth rate limiting ────────────────────────────────────────────────
        location ~ ^/api/auth/(login|register|refresh) {
            limit_req zone=auth burst=5 nodelay;
            proxy_pass         http://hopefx_backend;
            proxy_http_version 1.1;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        # ── WebSocket proxy (/ws/live, /ws/nuclear, /ws/*) ───────────────────
        # Must be declared before /api/ and / so nginx matches the
        # Upgrade header before the plain HTTP location blocks.
        location /ws/ {
            proxy_pass         http://hopefx_backend;
            proxy_http_version 1.1;
            proxy_set_header   Upgrade           $http_upgrade;
            proxy_set_header   Connection        "upgrade";
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # ── API proxy ─────────────────────────────────────────────────────────
        location /api/ {
            limit_req zone=api burst=20 nodelay;
            proxy_pass         http://hopefx_backend;
            proxy_http_version 1.1;
            proxy_set_header   Connection        "";
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_read_timeout 120s;
        }

        # ── GraphQL ───────────────────────────────────────────────────────────
        location /graphql {
            limit_req zone=api burst=20 nodelay;
            proxy_pass         http://hopefx_backend;
            proxy_http_version 1.1;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        # ── Nuclear supervisor + strategy (/nuclear, /nuclear-strategy) ───────
        # Mounted outside /api/ — must be proxied explicitly.
        location ~ ^/nuclear(-strategy)? {
            limit_req zone=api burst=20 nodelay;
            proxy_pass         http://hopefx_backend;
            proxy_http_version 1.1;
            proxy_set_header   Connection        "";
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_read_timeout 120s;
        }

        # ── TCA (Transaction Cost Analysis) (/tca) ────────────────────────────
        location /tca {
            limit_req zone=api burst=20 nodelay;
            proxy_pass         http://hopefx_backend;
            proxy_http_version 1.1;
            proxy_set_header   Connection        "";
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        # ── KYC / AML (/kyc) ──────────────────────────────────────────────────
        location /kyc {
            limit_req zone=api burst=10 nodelay;
            proxy_pass         http://hopefx_backend;
            proxy_http_version 1.1;
            proxy_set_header   Connection        "";
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        # ── Replay backtest (/replay) ─────────────────────────────────────────
        location /replay {
            limit_req zone=api burst=5 nodelay;
            proxy_pass         http://hopefx_backend;
            proxy_http_version 1.1;
            proxy_set_header   Connection        "";
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            # Backtests can run for several minutes
            proxy_read_timeout 300s;
        }

        # ── Decision engine (/decision) ───────────────────────────────────────
        location /decision {
            limit_req zone=api burst=20 nodelay;
            proxy_pass         http://hopefx_backend;
            proxy_http_version 1.1;
            proxy_set_header   Connection        "";
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        # ── GodMode dashboard (/godmode/) ─────────────────────────────────────
        location /godmode/ {
            proxy_pass         http://hopefx_backend;
            proxy_http_version 1.1;
            proxy_set_header   Connection        "";
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        # ── Prometheus metrics (/metrics) — internal monitoring only ──────────
        # Blocked from public internet; accessible only from private networks
        # and localhost (Prometheus scraper runs inside the same Docker network).
        location /metrics {
            allow 127.0.0.1;
            allow 10.0.0.0/8;
            allow 172.16.0.0/12;
            allow 192.168.0.0/16;
            deny  all;
            proxy_pass         http://hopefx_backend;
            proxy_http_version 1.1;
            proxy_set_header   Host $host;
            access_log off;
        }

        # ── Health check (no rate limit, no auth) ─────────────────────────────
        location /health {
            proxy_pass http://hopefx_backend;
            proxy_set_header Host $host;
            access_log off;
        }

        # ── React SPA — proxy all unmatched routes to FastAPI ─────────────────
        # FastAPI serves the built React bundle from /static/ and handles
        # SPA fallback (returns index.html for unknown client-side routes).
        location / {
            proxy_pass         http://hopefx_backend;
            proxy_http_version 1.1;
            proxy_set_header   Connection        "";
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }
    }
}
