{
  "app_name": "HOPEFX AI Trading",
  "version": "1.0.0",
  "environment": "test",
  "debug": false,
  "api_configs": {
    "binance": {
      "provider": "binance",
      "api_key": "",
      "api_secret": "",
      "sandbox_mode": true,
      "rate_limit": 100,
      "base_url": "",
      "timeout": 30,
      "max_retries": 3
    }
  },
  "database": {
    "db_type": "sqlite",
    "host": "localhost",
    "port": 5432,
    "username": "",
    "password": "",
    "database": "hopefx.db",
    "ssl_enabled": true,
    "ssl_mode": "prefer",
    "connection_pool_size": 10,
    "max_overflow": 20,
    "pool_timeout": 30
  },
  "trading": {
    "max_position_size": 10000.0,
    "max_leverage": 10.0,
    "stop_loss_percent": 2.0,
    "take_profit_percent": 4.0,
    "max_open_orders": 10,
    "risk_per_trade": 1.0,
    "daily_loss_limit": 5.0,
    "trading_enabled": false,
    "paper_trading_mode": true
  },
  "logging": {
    "level": "INFO",
    "log_file": "logs/hopefx.log",
    "max_file_size_mb": 100,
    "backup_count": 10,
    "format_string": "%(asctime)s %(levelname)s %(name)s %(message)s"
  }
}
