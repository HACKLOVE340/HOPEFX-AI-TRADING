# =============================================================================
# HOPEFX — PRODUCTION .env template (VPS / Docker)
# =============================================================================
# Copy to .env on the server and fill every REQUIRED value:
#     cp .env.production.example .env && nano .env
#
# Generate strong secrets with:   openssl rand -hex 32
# NEVER commit this filled-in file. NEVER paste secrets into a chat.
#
# NOTE: docker-compose builds DATABASE_URL and REDIS_URL automatically from the
# POSTGRES_* and REDIS_PASSWORD values below, pointing at the 'postgres' and
# 'redis' service containers. Do NOT set DATABASE_URL / REDIS_URL yourself here —
# that's what caused the localhost:6379 crash-loop.
# =============================================================================

# ── Core (REQUIRED) ──────────────────────────────────────────────────────────
APP_ENV=production
HOPEFX_DOMAIN=hopefx.site
ALLOWED_ORIGINS=https://hopefx.site
# APP_BASE_URL is the public origin the app puts INTO outgoing links. It was
# missing from this template, so it silently fell back to per-module defaults
# ("http://localhost:8000" in core/email_service.py and security/diagnostics.py,
# "https://hopefx.io" in api/billing.py and api/mobile.py) — meaning email
# verification / password-reset links and Stripe redirect URLs pointed at
# localhost or the wrong domain instead of the deployed one. Keep it equal to
# https://<HOPEFX_DOMAIN>.
APP_BASE_URL=https://hopefx.site
API_HOST=0.0.0.0
API_PORT=8000

# scripts/preflight.sh (runs before every container start, per the Dockerfile
# CMD) runs the full non-slow/non-integration pytest suite by default unless
# this is set — that can take several minutes, which is far longer than the
# Docker HEALTHCHECK's start-period + retries budget (~150s), so the
# container gets killed as "unhealthy" before the app process ever starts
# listening. CI already runs the full suite before merge; re-running it on
# every container start/restart in production is redundant, not an
# additional safety net. Leave unset only if you specifically want
# containers to self-verify on every start and have widened the
# HEALTHCHECK timing in the Dockerfile to match.
SKIP_TESTS=true

# ── Database — Postgres container (REQUIRED) ─────────────────────────────────
POSTGRES_USER=hopefx
POSTGRES_DB=hopefx
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password        # openssl rand -hex 24

# ── Redis container (REQUIRED — Redis runs with auth in prod) ────────────────
REDIS_PASSWORD=CHANGE_ME_strong_redis_password        # openssl rand -hex 24

# ── Grafana (REQUIRED — docker-compose.yml hard-fails to start ANY service,
# not just Grafana, if this is unset; compose validates the whole file up front) ──
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_grafana_password  # openssl rand -hex 16

# ── Security secrets (REQUIRED — app refuses to start in prod without these) ──
SECURITY_JWT_SECRET=CHANGE_ME_64_hex_chars            # openssl rand -hex 32  (>=32 chars)
CONFIG_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars          # openssl rand -hex 32  (encrypts stored creds)
HOPEFX_KILL_SWITCH_TOKEN=CHANGE_ME_random             # openssl rand -hex 24  (deactivate trading halts)
CRYPTO_WEBHOOK_SECRET=CHANGE_ME_random                # openssl rand -hex 24  (signs crypto webhooks)

# ── Additional app-internal secrets (REQUIRED) ───────────────────────────────
# These were previously missing from this production template even though the
# local-dev bootstrap (scripts/bootstrap_dev.py) generates all of them, so a
# VPS deploy silently ran without them. Each IS read by real app code:
#   CONFIG_SALT                 config/config_manager.py, utils/security.py
#                               (must be valid HEX or config_manager raises)
#   HOPEFX_MASTER_KEY           security/key_manager.py — HARD FAILS with
#                               SecurityError when a production key is required.
#                               MUST be padded base64 decoding to >=32 bytes;
#                               note token_urlsafe(32) does NOT satisfy this
#                               (43 chars -> "Incorrect padding"), so generate
#                               with: openssl rand -base64 32 | tr '+/' '-_'
#   HOPEFX_ENCRYPTION_KEY       security/production_config.py
#   SECRET_KEY                  security_service.py
#   JWT_SECRET                  whitelabel/tenant_isolation.py
#   JWT_SECRET_KEY              config/settings.py, auth/jwt.py
#   LICENSE_SECRET              monetization/subscription.py
#   WHITELABEL_KEY_HASH_SECRET  whitelabel/api_auth.py (falls back to
#                               CONFIG_ENCRYPTION_KEY, but set it explicitly)
#   TRADINGVIEW_WEBHOOK_SECRET  api/webhooks.py — endpoint stays DISABLED while
#                               unset; paste this same value into TradingView.
#   DB_PASSWORD                 utils/config.py — keep equal to POSTGRES_PASSWORD.
CONFIG_SALT=CHANGE_ME_32_hex_chars                    # openssl rand -hex 16 (HEX ONLY)
HOPEFX_MASTER_KEY=CHANGE_ME_base64_32_bytes           # openssl rand -base64 32 | tr '+/' '-_'
HOPEFX_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes       # openssl rand -base64 32 | tr '+/' '-_'
SECRET_KEY=CHANGE_ME_64_hex_chars                     # openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_hex_chars                     # openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_64_hex_chars                 # openssl rand -hex 32
LICENSE_SECRET=CHANGE_ME_64_hex_chars                 # openssl rand -hex 32
WHITELABEL_KEY_HASH_SECRET=CHANGE_ME_64_hex_chars     # openssl rand -hex 32
TRADINGVIEW_WEBHOOK_SECRET=CHANGE_ME_64_hex_chars     # openssl rand -hex 32
DB_PASSWORD=CHANGE_ME_same_as_POSTGRES_PASSWORD       # keep == POSTGRES_PASSWORD

# NOTE: third-party credentials are deliberately NOT auto-generated here or by
# vps_bootstrap.sh (STRIPE_PRICE_*, BYBIT_API_KEY/SECRET, IBKR_FIX_PASSWORD,
# FIX_PASSWORD, CME_FIX_PASSWORD). scripts/bootstrap_dev.py fabricates random
# values for those because local dev never calls the real services, but in
# production a fake value is worse than an empty one: the app would treat it as
# a valid credential and fail at call time instead of cleanly reporting the
# integration as unconfigured. Set them from the real provider dashboards, or
# leave blank to keep the integration disabled.

# ── Seed accounts (set once; used to create the first logins) ────────────────
BOOTSTRAP_SUPERADMIN_PASSWORD=CHANGE_ME_superadmin_login
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_login
BOOTSTRAP_TRADER_PASSWORD=CHANGE_ME_trader_login

# ── AI provider (REQUIRED for the AI assistant/brain) ────────────────────────
# Pick ONE backend and set its matching key. See docs/AI_PROVIDER.md.
# LLM_BACKEND accepts: anthropic (default) or openai
LLM_BACKEND=anthropic
# IMPORTANT: do NOT put a trailing "# comment" on these two lines. Docker
# Compose's env_file parser strips an inline comment only when the value is
# non-empty; for an EMPTY value it takes the comment text itself as the value,
# so `ANTHROPIC_API_KEY=   # if LLM_BACKEND=anthropic` silently resolved to the
# literal string "# if LLM_BACKEND=anthropic" and was passed to the app as a
# real API key. Verified with `docker compose config`. Keep these bare.
# Set ANTHROPIC_API_KEY when LLM_BACKEND=anthropic:
ANTHROPIC_API_KEY=
# Set OPENAI_API_KEY when LLM_BACKEND=openai:
OPENAI_API_KEY=

# ── Broker (default paper — safe; no live money) ─────────────────────────────
BROKER_TYPE=paper
# For live OANDA, set BROKER_TYPE=oanda and fill:
# OANDA_API_KEY=
# OANDA_ACCOUNT_ID=

# ── Optional market-data / news API keys (missing → free yfinance fallback) ──
FINNHUB_API_KEY=
TWELVE_API_KEY=
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
NEWSAPI_KEY=
GOLDAPI_KEY=

# ── Optional integrations (leave blank if unused) ────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENDGRID_API_KEY=
TELEGRAM_BOT_TOKEN=

# =============================================================================
# Remaining docker-compose variables — previously ABSENT from this template.
#
# docker-compose.yml references 58 variables; this file listed only 44, so these
# were invisible here and silently took whatever default was buried in the
# compose file. Any of them referenced as a bare ${VAR} (no :- default) also
# emitted "variable is not set. Defaulting to a blank string" on every
# docker compose run. Listed explicitly now with the exact default compose was
# already using, so behaviour is unchanged but visible and editable.
#
# NOTE: never append a trailing '# comment' to a line whose value is EMPTY —
# Compose's env_file parser keeps the comment AS the value in that case.
# =============================================================================

# ── Safety / risk posture — REVIEW THESE ────────────────────────
PAPER_TRADING=true
IS_FORCE_TLS=false
REDIS_FORCE_TLS=false
HOPEFX_INVARIANT_MODE=monitor
HOPEFX_INVARIANT_FAIL_CLOSED=0
HOPEFX_INVARIANT_ENFORCE_KINDS=order_authorization,pre_trade
RISK_MAX_SYMBOL_EXPOSURE_USD=1000000.0
RISK_MAX_TICK_STALENESS_S=5.0
RISK_APPROVED_VAR_USD=0
RISK_HUMAN_APPROVAL_NOTIONAL_USD=0

# ── AI / LLM tuning ─────────────────────────────────────────────
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=o4-mini
LLM_MAX_TOKENS=8192
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0
LLM_SECURITY_MAX_TOKENS=1024
BRAIN_SCAN_INTERVAL=30
BRAIN_HEAL_INTERVAL=1800
BRAIN_SEMANTIC_ENCODER=false

# ── Alertmanager notifications (blank = alerts disabled) ────────
ALERTMANAGER_SMTP_FROM=alerts@hopefx.io
ALERTMANAGER_SMTP_TO=
ALERTMANAGER_SMTP_HOST=localhost:587
ALERTMANAGER_SMTP_USERNAME=
ALERTMANAGER_SMTP_PASSWORD=
ALERTMANAGER_TELEGRAM_BOT_TOKEN=
ALERTMANAGER_TELEGRAM_CHAT_ID=0

# ── CME / FIX broker (CME_ENABLED=false keeps this off) ─────────
CME_ENABLED=false
CME_FIX_HOST=127.0.0.1
CME_FIX_PORT=9876
CME_FIX_SENDER_ID=HOPEFX
CME_FIX_TARGET_ID=CME
CME_FIX_USERNAME=
CME_FIX_PASSWORD=
CME_ACCOUNT=
CME_IBKR_FALLBACK=true
CME_PAPER_FALLBACK=true
CME_LATENCY_WARN_MS=50
OANDA_PRACTICE=true

# ── C++ low-latency shim (disabled by default) ──────────────────
CPP_SHIM_ENABLED=false
CPP_SHIM_ZMQ_CMD_ADDR=tcp://127.0.0.1:6555
CPP_SHIM_ZMQ_RESP_ADDR=tcp://127.0.0.1:6556
CPP_SHIM_TIMEOUT_MS=5000
CPP_SHIM_LATENCY_WARN_US=1000

# ── Misc integrations ───────────────────────────────────────────
FLASHPOINT_API_KEY=
FLASHPOINT_API_URL=https://api.flashpoint.io/v1/iocs
ARGOCD_ROLLBACK_WEBHOOK=
# (added 46 variables)

# =============================================================================
# Trading / risk / auth operational settings
# =============================================================================
# These are read directly by app code (not via docker-compose), so they never
# produced a compose warning and were easy to miss — but they govern position
# sizing, stop placement and session policy. Every value below is the EXACT
# default the code already applies when the variable is unset, so adding them
# changes nothing at runtime; it only makes them visible and editable.
# Confirmed by reading each getenv() call site, not assumed.

# ── Risk limits (money-path) ──────────────────────────────────────────────────
# NOTE: RISK_MAX_POSITION_SIZE_PCT is the one value where the code default (0.05
# = 5%) is LOOSER than what scripts/bootstrap_dev.py uses locally (0.02 = 2%).
# It is left at the code default here so this file does not silently change
# behaviour. If you want production to match what you have been testing against
# locally, set it to 0.02 — that is the tighter, more conservative setting.
RISK_MAX_POSITION_SIZE_PCT=0.05
RISK_MAX_DRAWDOWN_PCT=0.10
RISK_MAX_DAILY_LOSS_PCT=0.05

# ── Signal engine / execution ─────────────────────────────────────────────────
# SIGNAL_ENGINE_AUTO_TRADE=false means signals are generated but NOT auto-sent
# to the broker. Keep false until you have completed a paper run.
SIGNAL_ENGINE_AUTO_TRADE=false
SIGNAL_ENGINE_SYMBOLS=XAU_USD
SIGNAL_THRESHOLD_LONG=0.58
SIGNAL_THRESHOLD_SHORT=0.42
ML_MIN_TRADE_PROB=0.58
SL_ATR_MULT=1.5
TP_ATR_MULT=3.0
INITIAL_BALANCE=10000
PAPER_STARTING_BALANCE=100000

# ── News blackout window (minutes around high-impact events) ──────────────────
NEWS_BLACKOUT_BEFORE_MIN=5
NEWS_BLACKOUT_AFTER_MIN=5

# ── Security posture (all already secure-by-default; surfaced so you can see) ─
# Do NOT set these to false in production. Gate L (scripts/ci/gate_l_safety_
# invariants.py) enforces WS_AUTH_REQUIRED in CI.
WS_AUTH_REQUIRED=true
CSRF_PROTECTION=true
STARTUP_GATE=true

# ── Session / token lifetimes ─────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Outbound email (blank SMTP_HOST = email sending disabled) ─────────────────
# REQUIRE_EMAIL_VERIFICATION is false because with no SMTP configured, requiring
# verification would lock every new signup out. Set it true only AFTER SMTP works.
REQUIRE_EMAIL_VERIFICATION=false
SMTP_PORT=587
# Names here are the ones the code ACTUALLY reads, verified against each
# getenv() call site. Two earlier entries in this file were wrong and therefore
# inert — a misspelled name fails silently, it does not error:
#   SMTP_TLS    was wrong -> core/email_service.py:82 reads SMTP_USE_TLS
#   EMAIL_FROM  was wrong -> core/email_service.py:45 reads FROM_EMAIL
# FROM_EMAIL is the SendGrid sender; its code default is noreply@hopefx.io,
# which is the wrong domain for this deployment, so set it explicitly.
SMTP_USE_TLS=true
FROM_EMAIL=noreply@hopefx.site
# Verification-link lifetime (auth/router.py); 86400 = 24h, the code default.
EMAIL_VERIFY_TTL_SECONDS=86400
# Leave the rest blank to keep email disabled (no trailing comments here —
# an inline comment on an empty value is captured AS the value by Compose).
# SMTP_USER and SMTP_USERNAME are separate names read by different modules
# (core/email_service.py vs core/health.py) — set both to the same value.
SMTP_HOST=
SMTP_USER=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# ── Error monitoring (blank DSN = Sentry disabled) ────────────────────────────
SENTRY_ENVIRONMENT=production
SENTRY_DSN=
