# =============================================================================
# HOPEFX — PRODUCTION .env template (VPS / Docker)
# =============================================================================
# Copy to .env on the server and fill every REQUIRED value:
#     cp .env.production.example .env && nano .env
#
# Generate strong secrets with:   openssl rand -hex 32
# NEVER commit this filled-in file. NEVER paste secrets into a chat.
#
# NOTE: docker-compose builds DATABASE_URL and REDIS_URL automatically from the
# POSTGRES_* and REDIS_PASSWORD values below, pointing at the 'postgres' and
# 'redis' service containers. Do NOT set DATABASE_URL / REDIS_URL yourself here —
# that's what caused the localhost:6379 crash-loop.
# =============================================================================

# ── Core (REQUIRED) ──────────────────────────────────────────────────────────
APP_ENV=production
HOPEFX_DOMAIN=hopefx.site
ALLOWED_ORIGINS=https://hopefx.site
API_HOST=0.0.0.0
API_PORT=8000

# ── Database — Postgres container (REQUIRED) ─────────────────────────────────
POSTGRES_USER=hopefx
POSTGRES_DB=hopefx
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password        # openssl rand -hex 24

# ── Redis container (REQUIRED — Redis runs with auth in prod) ────────────────
REDIS_PASSWORD=CHANGE_ME_strong_redis_password        # openssl rand -hex 24

# ── Grafana (REQUIRED — docker-compose.yml hard-fails to start ANY service,
# not just Grafana, if this is unset; compose validates the whole file up front) ──
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_grafana_password  # openssl rand -hex 16

# ── Security secrets (REQUIRED — app refuses to start in prod without these) ──
SECURITY_JWT_SECRET=CHANGE_ME_64_hex_chars            # openssl rand -hex 32  (>=32 chars)
CONFIG_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars          # openssl rand -hex 32  (encrypts stored creds)
HOPEFX_KILL_SWITCH_TOKEN=CHANGE_ME_random             # openssl rand -hex 24  (deactivate trading halts)
CRYPTO_WEBHOOK_SECRET=CHANGE_ME_random                # openssl rand -hex 24  (signs crypto webhooks)

# ── Seed accounts (set once; used to create the first logins) ────────────────
BOOTSTRAP_SUPERADMIN_PASSWORD=CHANGE_ME_superadmin_login
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_login
BOOTSTRAP_TRADER_PASSWORD=CHANGE_ME_trader_login

# ── AI provider (REQUIRED for the AI assistant/brain) ────────────────────────
# Pick ONE backend and set its matching key. See docs/AI_PROVIDER.md.
LLM_BACKEND=anthropic                                 # or: openai
ANTHROPIC_API_KEY=                                    # if LLM_BACKEND=anthropic
OPENAI_API_KEY=                                       # if LLM_BACKEND=openai

# ── Broker (default paper — safe; no live money) ─────────────────────────────
BROKER_TYPE=paper
# For live OANDA, set BROKER_TYPE=oanda and fill:
# OANDA_API_KEY=
# OANDA_ACCOUNT_ID=

# ── Optional market-data / news API keys (missing → free yfinance fallback) ──
FINNHUB_API_KEY=
TWELVE_API_KEY=
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
NEWSAPI_KEY=
GOLDAPI_KEY=

# ── Optional integrations (leave blank if unused) ────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENDGRID_API_KEY=
TELEGRAM_BOT_TOKEN=
