{
	"name": "HOPEFX AI Trading",
	// Python 3.10 matches the production Dockerfile (python:3.10-slim).
	// Using the same version prevents pickle protocol mismatches for ML models
	// and ensures behaviour parity between local dev and Docker.
	"image": "mcr.microsoft.com/devcontainers/python:3.10-bullseye",
	"features": {
		// Node.js LTS — required for the React/Vite frontend build toolchain.
		"ghcr.io/devcontainers/features/node:1": {
			"version": "20"
		},
		// C++ build toolchain for execution/cpp_shim.
		"ghcr.io/devcontainers/features/common-utils:2": {}
	},
	// Redis is installed via apt (more reliable than third-party features).
	// postCreateCommand runs after the container is fully initialised.
	"postCreateCommand": "apt-get update -qq && apt-get install -y --no-install-recommends redis-server cmake libzmq3-dev pkg-config ninja-build && pip install -q -r requirements-ci.txt && cd frontend && npm install",
	"forwardPorts": [5173, 8000, 6379],
	"portsAttributes": {
		"5173": {
			"label": "Frontend (Vite)",
			"onAutoForward": "openPreview"
		},
		"8000": {
			"label": "Backend (FastAPI)",
			"onAutoForward": "silent"
		},
		"6379": {
			"label": "Redis",
			"onAutoForward": "silent"
		}
	},
	"remoteEnv": {
		"APP_ENV": "development"
	}
}
