[coverage]
# Scope: critical paths only — auth, risk, brokers, execution, market_data, ml
source =
    auth
    risk
    brokers
    execution
    market_data
    ml
    config
branch = true
omit =
    */tests/*
    */examples/*
    */migrations/*
    */alembic/*
    */venv/*
    */.venv/*
    */site-packages/*
    */setup.py
    */conftest.py
    */__pycache__/*
    brokers/oanda.py
    brokers/oanda_stream.py
    brokers/oanda_ws.py
    brokers/interactive_brokers.py
    ml/rl_agent.py
    ml/advanced_ai.py
report_precision = 2
fail_under = 75
show_missing = true
skip_empty = true

[html]
directory = coverage_html_report
title = HOPEFX Coverage Report — Critical Paths

[xml]
output = coverage.xml
