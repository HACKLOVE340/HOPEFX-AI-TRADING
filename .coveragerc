[coverage]
# Scope: core application packages only — excludes optional/whitelabel modules
# that are not yet covered by the test suite.
source =
    auth
    risk
    brokers
    execution
    market_data
    ml
    config
    kill_switch
    compliance
    analytics
    backtesting
branch = true
omit =
    */tests/*
    */examples/*
    */migrations/*
    */alembic/*
    */venv/*
    */.venv/*
    */site-packages/*
    */setup.py
    */conftest.py
    */__pycache__/*
    brokers/oanda.py
    brokers/oanda_stream.py
    brokers/oanda_ws.py
    brokers/interactive_brokers.py
    ml/rl_agent.py
    ml/advanced_ai.py
    whitelabel/*
report_precision = 2
# Global baseline — individual critical-path gates are enforced in CI
fail_under = 70
show_missing = true
skip_empty = true

[html]
directory = coverage_html_report
title = HOPEFX Coverage Report — Critical Paths

[xml]
output = coverage.xml

# ── Critical path coverage gates ──────────────────────────────────────────────
# These are enforced as separate pytest-cov runs in CI (see .github/workflows/ci.yml).
# Each critical module must maintain ≥90% branch coverage.
#
# Modules gated at 90%:
#   risk/           — VaR, drawdown, position sizing, circuit breakers
#   execution/      — order routing, engine, TCA, algo orders
#   kill_switch.py  — system-wide halt mechanism
#   brokers/        — broker adapters (excluding live-only files)
#   compliance/     — KYC/AML gateway and rules
