# HOPEFX-AI-TRADING — Coverage Configuration
# This is the single authoritative source for coverage settings.
# All other config files (setup.cfg, pytest.ini, pyproject.toml) must NOT
# contain [coverage:*] or [tool.coverage.*] sections.
# CI passes --cov-config=.coveragerc explicitly.

[run]
# Measure branch coverage across all core application packages.
source =
    auth
    risk
    brokers
    execution
    market_data
    ml
    config
    kill_switch
    compliance
    analytics
    brain
    news
    backtesting
    core
    # ── Added 2026-09-04 (F221) ───────────────────────────────────────────────
    # The gate measured 26.9% of the application and every money package was
    # outside it. These are in because they are already tested well enough to
    # carry the 70% floor — measured, not assumed:
    #   invariants 96% · strategies 68% · database 66% · notifications 54%
    #   news 53% · monetization 55% · payments 42%
    # `invariants/` is the constitutional safety layer and was not measured at
    # all; `monetization/` and `payments/` are the code that pays creators and
    # takes card payments.
    #
    # Still outside, with the reason: api/ (43%), data_layer/ (41%),
    # security/ (38%), data/ (51%), utils/ (57%), scripts/, analysis/,
    # research/. Adding them today drops the total below the 70% floor, and the
    # floor is not moving to accommodate them. `scripts/coverage_scope_report.py`
    # prints the resulting scope in CI so the gap stays visible rather than
    # implied.
    #
    # Measured after this change: 17498 passed, total coverage 70.54% -- i.e.
    # 0.54 points of headroom over the floor. That is thin on purpose: the
    # packages were added up to the point where the gate still passes, and no
    # further. If a commit tips it under 70%, the fix is to test the package
    # that dropped it, NOT to remove a package from this list or lower the
    # floor -- both of those restore the number by shrinking what it describes,
    # which is the defect F221 was about in the first place.
    invariants
    strategies
    database
    notifications
    news
    monetization
    payments
branch = true
omit =
    */tests/*
    */examples/*
    */migrations/*
    */alembic/*
    */venv/*
    */.venv/*
    */site-packages/*
    */setup.py
    */conftest.py
    */__pycache__/*
    # Live-only broker files — require real credentials, excluded from unit coverage
    brokers/oanda.py
    brokers/oanda_stream.py
    brokers/oanda_ws.py
    brokers/interactive_brokers.py
    # Optional ML modules with heavy external deps
    ml/rl_agent.py
    ml/advanced_ai.py
    # Whitelabel customisations are not part of the core test suite
    whitelabel/*
    # ── F105 ──────────────────────────────────────────────────────────────────
    # The four risk files that used to sit here -- risk/manager.py,
    # gatekeeper.py, pre_trade_gate.py, post_trade_analyzer.py -- were excluded
    # with the justification "depend on live event bus / orchestrator wiring;
    # covered by integration tests, not unit tests". Measured against the unit
    # suite with the omit removed, they come out at:
    #
    #     risk/pre_trade_gate.py        94.39%
    #     risk/manager.py               89.65%
    #     risk/gatekeeper.py            85.63%
    #     risk/post_trade_analyzer.py   82.40%
    #
    # All four clear the 80% gate they were excluded from, on the unit suite
    # alone. `risk/manager.py` is the file CLAUDE.md names as the risk core --
    # the pre-trade gate, VaR/CVaR, Kelly sizing and the kill switch -- and
    # "risk/ >= 80%" was a true statement about the two thirds of risk/ that is
    # not the dangerous part. They are measured now.
    #
    # The execution files below stay omitted, but not for the reason previously
    # given. No integration test references execution/engine.py or
    # core/decision/HOPEFXDecisionEngine.py at all (grep of tests/integration/:
    # zero files), so "covered by integration tests" was not true of them
    # either. What is true is their measured unit coverage, recorded here so the
    # exclusion is a known debt rather than a claim:
    #
    #     execution/engine.py                     76.11%
    #     core/decision/HOPEFXDecisionEngine.py   64.71%
    #     execution/hopefx_engine.py              63.05%
    #     execution/fix_adapter.py                35.00%
    #     execution/execution.py                  17.75%
    #
    # engine.py is close enough that testing it is the way to remove it from
    # this list; the others are genuinely thin. Do not re-add a justification
    # that names a test suite without checking that the suite exists.
    execution/execution.py
    execution/hopefx_engine.py
    execution/fix_adapter.py
    execution/fix_router.py
    execution/legacy.py
    execution/_prom_metrics.py
    execution/engine.py
    # core/ modules excluded from unit coverage:
    # GPU engine requires CUDA hardware — untestable in CI without GPU
    core/acceleration/gpu_engine.py
    # GPU inference package init — wraps gpu_engine, hardware-dependent
    core/acceleration/__init__.py
    # Decision engine requires full app wiring (brain+risk+executor+bus)
    # covered by integration tests
    core/decision/HOPEFXDecisionEngine.py
    # Background tasks, health, metrics, middleware, page_routes are
    # FastAPI-wired and covered by API integration tests
    core/background_tasks.py
    core/health.py
    core/metrics.py
    core/middleware.py
    core/page_routes.py
    core/email_webhook.py
    # Startup factories require full app context; covered by integration/e2e
    # tests, not unit tests.
    #
    # `core/router_registry.py` used to sit here under the same justification.
    # It was false: tests/unit/test_core_router_registry.py already existed and
    # exercised `register_routers` directly. The exclusion had a cost — the
    # per-module coverage gate could not measure the file, reported "coverage
    # could not be measured — the test may not import the module" (a wrong
    # diagnosis: the test imports it on line 19), and BLOCKED every commit that
    # touched it. Measured with the exclusion lifted it was 74.7%; the
    # sixty-odd `except ImportError` fallbacks were 25% of the module and had
    # never been exercised. Those branches now have tests and it measures 87%.
    core/startup_factories.py
    # Advanced risk engine (Monte Carlo/GARCH) requires live risk bus wiring;
    # covered by integration tests
    core/risk/advanced_engine.py

[report]
precision = 2
# Global baseline — individual critical-path gates are enforced separately in CI.
# See .github/workflows/ci.yml and tests.yml for per-package 80% branch gates.
fail_under = 70
show_missing = true
skip_empty = true
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:

[html]
directory = coverage_html_report
title = HOPEFX Coverage Report — Critical Paths

[xml]
output = coverage.xml

# ── Critical path coverage gates ──────────────────────────────────────────────
# Enforced as separate pytest-cov runs in CI (see .github/workflows/ci.yml
# and .github/workflows/tests.yml).
# Each critical module must maintain ≥80% branch coverage.
#
#   risk/           — VaR, drawdown, position sizing, circuit breakers
#   execution/      — order routing, engine, TCA, algo orders
#   kill_switch.py  — system-wide halt mechanism
#   brokers/        — broker adapters (excluding live-only files above)
#   compliance/     — KYC/AML gateway and rules
