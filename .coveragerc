# HOPEFX-AI-TRADING — Coverage Configuration
# This is the single authoritative source for coverage settings.
# All other config files (setup.cfg, pytest.ini, pyproject.toml) must NOT
# contain [coverage:*] or [tool.coverage.*] sections.
# CI passes --cov-config=.coveragerc explicitly.

[run]
# Measure branch coverage across all core application packages.
source =
    auth
    risk
    brokers
    execution
    market_data
    ml
    config
    kill_switch
    compliance
    analytics
    brain
    news
    backtesting
    core
    # ── Added 2026-09-04 (F221) ───────────────────────────────────────────────
    # The gate measured 26.9% of the application and every money package was
    # outside it. These are in because they are already tested well enough to
    # carry the 70% floor — measured, not assumed:
    #   invariants 96% · strategies 68% · database 66% · notifications 54%
    #   news 53% · monetization 55% · payments 42%
    # `invariants/` is the constitutional safety layer and was not measured at
    # all; `monetization/` and `payments/` are the code that pays creators and
    # takes card payments.
    #
    # Still outside, with the reason: api/ (43%), data_layer/ (41%),
    # security/ (38%), data/ (51%), utils/ (57%), scripts/, analysis/,
    # research/. Adding them today drops the total below the 70% floor, and the
    # floor is not moving to accommodate them. `scripts/coverage_scope_report.py`
    # prints the resulting scope in CI so the gap stays visible rather than
    # implied.
    #
    # Measured after this change: 17498 passed, total coverage 70.54% -- i.e.
    # 0.54 points of headroom over the floor. That is thin on purpose: the
    # packages were added up to the point where the gate still passes, and no
    # further. If a commit tips it under 70%, the fix is to test the package
    # that dropped it, NOT to remove a package from this list or lower the
    # floor -- both of those restore the number by shrinking what it describes,
    # which is the defect F221 was about in the first place.
    invariants
    strategies
    database
    notifications
    news
    monetization
    payments
branch = true
omit =
    */tests/*
    */examples/*
    */migrations/*
    */alembic/*
    */venv/*
    */.venv/*
    */site-packages/*
    */setup.py
    */conftest.py
    */__pycache__/*
    # The four broker files here were excluded as "live-only — require real
    # credentials". Not true of the unit suite: seven unit tests import
    # brokers/oanda.py, three brokers/oanda_stream.py, two brokers/oanda_ws.py
    # and one brokers/interactive_brokers.py, all without credentials. Live
    # OANDA is the next milestone (CLAUDE.md), so this is the coverage figure
    # for the code about to move real money — hidden. Lifted 2026-09-10 (§E49).
    #
    # ml/advanced_ai.py was excluded as "heavy external deps"; a unit test
    # imports it (it is the module pinned out of production as superseded).
    # Lifted with them.
    #
    # ml/rl_agent.py stays: no unit test imports it, verified rather than
    # asserted, and re-checked on every run.
    ml/rl_agent.py
    # Whitelabel customisations are not part of the core test suite
    whitelabel/*
    # ── F105 ──────────────────────────────────────────────────────────────────
    # The four risk files that used to sit here -- risk/manager.py,
    # gatekeeper.py, pre_trade_gate.py, post_trade_analyzer.py -- were excluded
    # with the justification "depend on live event bus / orchestrator wiring;
    # covered by integration tests, not unit tests". Measured against the unit
    # suite with the omit removed, they come out at:
    #
    #     risk/pre_trade_gate.py        94.39%
    #     risk/manager.py               89.65%
    #     risk/gatekeeper.py            85.63%
    #     risk/post_trade_analyzer.py   82.40%
    #
    # All four clear the 80% gate they were excluded from, on the unit suite
    # alone. `risk/manager.py` is the file CLAUDE.md names as the risk core --
    # the pre-trade gate, VaR/CVaR, Kelly sizing and the kill switch -- and
    # "risk/ >= 80%" was a true statement about the two thirds of risk/ that is
    # not the dangerous part. They are measured now.
    #
    # The execution files used to sit here with their measured coverage written
    # in this comment. That was already an improvement on the false "covered by
    # integration tests" it replaced — but a number in a comment has no
    # pressure behind it. It goes stale silently, and nothing blocks when the
    # module clears the floor.
    #
    # They are LIFTED 2026-09-10 (§E49) and recorded in
    # docs/COVERAGE_UNMEASURABLE.txt instead, where the gate reads them, reports
    # the current figure on every commit that touches them, and BLOCKS with one
    # instruction the moment one reaches 80%. Same for
    # core/decision/HOPEFXDecisionEngine.py and the FastAPI-wired core modules
    # that unit tests demonstrably import.
    #
    # The rule this list now follows, enforced by
    # tests/unit/test_coveragerc_exclusions_are_honest.py: a module that unit
    # tests import may not be excluded. Three exclusions had already been found
    # false under a justification naming a test suite that does not cover them
    # — router_registry (§E37), startup_factories (§E47), and then 18 of the 23
    # concrete entries at once (§E49). It was not a policy; it was an
    # accumulation.
    # core/ modules excluded from unit coverage. Each reason below is a property
    # of the MACHINE or of the module's dependencies — never a claim about the
    # test suite, which is the claim that kept turning out false.
    # GPU engine requires CUDA hardware — untestable in CI without GPU
    core/acceleration/gpu_engine.py
    # Background tasks and the email webhook: no unit test imports either,
    # verified rather than asserted (see DELIBERATE in
    # tests/unit/test_coveragerc_exclusions_are_honest.py, which re-checks that
    # on every run so the reason cannot expire unnoticed).
    core/background_tasks.py
    core/email_webhook.py
    # `core/router_registry.py` used to sit here under "requires full app
    # context; covered by integration/e2e tests, not unit tests". It was false:
    # tests/unit/test_core_router_registry.py already existed and exercised
    # `register_routers` directly. The exclusion had a cost — the per-module
    # coverage gate could not measure the file, reported "coverage could not be
    # measured — the test may not import the module" (a wrong diagnosis: the
    # test imports it on line 19), and BLOCKED every commit that touched it.
    # Measured with the exclusion lifted it was 74.7%; the sixty-odd
    # `except ImportError` fallbacks were 25% of the module and had never been
    # exercised. Those branches now have tests and it measures 87%.
    #
    # `core/startup_factories.py` sat here under the SAME justification and it
    # was false the same way: tests/unit/test_startup_factories.py and
    # tests/unit/test_core_startup_factories.py exercise it directly, 59 tests
    # between them. Lifted 2026-09-10 (§E47). An exclusion is not a
    # measurement, and a module nothing may measure is a module nothing can
    # ratchet.
    # core/risk/advanced_engine.py was excluded as "requires live risk bus
    # wiring; covered by integration tests". Two unit tests import it directly.
    # Lifted 2026-09-10 (§E49) — and it is risk code, which is the last place a
    # coverage figure should be invisible.

[report]
precision = 2
# Global baseline — individual critical-path gates are enforced separately in CI.
# See .github/workflows/ci.yml and tests.yml for per-package 80% branch gates.
fail_under = 70
show_missing = true
skip_empty = true
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:

[html]
directory = coverage_html_report
title = HOPEFX Coverage Report — Critical Paths

[xml]
output = coverage.xml

# ── Critical path coverage gates ──────────────────────────────────────────────
# Enforced as separate pytest-cov runs in CI (see .github/workflows/ci.yml
# and .github/workflows/tests.yml).
# Each critical module must maintain ≥80% branch coverage.
#
#   risk/           — VaR, drawdown, position sizing, circuit breakers
#   execution/      — order routing, engine, TCA, algo orders
#   kill_switch.py  — system-wide halt mechanism
#   brokers/        — broker adapters (excluding live-only files above)
#   compliance/     — KYC/AML gateway and rules
