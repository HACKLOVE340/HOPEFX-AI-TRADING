[coverage]
source = .
branch = true
omit =
    */tests/*
    */examples/*
    */migrations/*
    */alembic/*
    */venv/*
    */.venv/*
    */site-packages/*
    */setup.py
    */conftest.py
    */__pycache__/*
report_precision = 2
# Coverage gate: 70% line + branch coverage required.
# Enforced in both tests.yml and ci.yml.
# Increase to 75% once ML and data modules have unit tests.
fail_under = 70
show_missing = true
skip_empty = true

[html]
directory = coverage_html_report
title = HOPEFX Coverage Report

[xml]
output = coverage.xml