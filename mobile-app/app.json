{
  "expo": {
    "name": "HopeFX Trading",
    "slug": "hopefx-trading",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0f1c"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.hopefx.trading",
      "buildNumber": "2",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Authenticate to access your trading account",
        "NSCameraUsageDescription": "Used for KYC document scanning"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0f1c"
      },
      "package": "io.hopefx.trading",
      "versionCode": 2,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00d4aa",
          "sounds": ["./assets/sounds/signal.wav", "./assets/sounds/risk_alert.wav"]
        }
      ]
    ],
    "scheme": "hopefx",
    "extra": {
      "eas": {
        "projectId": "hopefx-trading-app"
      },
      "apiBaseUrl": "https://api.hopefx.io",
      "wsBaseUrl": "wss://api.hopefx.io"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/hopefx-trading-app"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
