# =============================================================================
# HOPEFX AI Trading — Environment Variables
# =============================================================================
# Copy to .env and fill in ALL values before starting.
#   cp .env.example .env
#
# For GoDaddy VPS: run deploy.sh — it writes .env automatically.
#
# Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================


# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production
APP_BASE_URL=https://YOUR_DOMAIN


# ── Security (REQUIRED — generate unique values, never reuse) ─────────────────
SECURITY_JWT_SECRET=CHANGE_ME_generate_64_char_hex_secret
CONFIG_ENCRYPTION_KEY=CHANGE_ME_generate_48_char_urlsafe_key
HOPEFX_KILL_SWITCH_TOKEN=CHANGE_ME_generate_64_char_hex_token
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60


# ── Database ──────────────────────────────────────────────────────────────────
# Production: PostgreSQL (docker compose provides the db service)
DATABASE_URL=postgresql+asyncpg://hopefx:CHANGE_ME_db_password@db:5432/hopefx
POSTGRES_USER=hopefx
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=hopefx
DB_HOST=db
DB_PASSWORD=CHANGE_ME_db_password
# Development only (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./hopefx.db


# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password


# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=https://YOUR_DOMAIN,https://www.YOUR_DOMAIN
MOBILE_CORS_ORIGINS=


# ── Broker ────────────────────────────────────────────────────────────────────
# Start with paper. Switch to live only after thorough testing.
BROKER_TYPE=paper
INITIAL_BALANCE=100000
COMMISSION=3.5
PAPER_USER_ID=paper
SIGNAL_ENGINE_AUTO_TRADE=false

# OANDA (required when BROKER_TYPE=oanda)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# MetaTrader 5 (required when BROKER_TYPE=mt5)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# cTrader (required when BROKER_TYPE=ctrader)
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCOUNT_ID=


# ── Risk management ───────────────────────────────────────────────────────────
RISK_MAX_POSITION_SIZE_PCT=0.05
RISK_MAX_DRAWDOWN_PCT=0.10
RISK_MAX_DAILY_LOSS_PCT=0.05
RISK_KELLY_FRACTION=0.25
RISK_MIN_RR=2.0


# ── ML / Signal engine ────────────────────────────────────────────────────────
ML_MIN_TRADE_PROB=0.58
SL_ATR_MULT=1.5
TP_ATR_MULT=3.0


# ── AML / Compliance ──────────────────────────────────────────────────────────
AML_SINGLE_WITHDRAWAL_CAP=10000
AML_DAILY_WITHDRAWAL_LIMIT=50000
AML_MAX_WITHDRAWALS_PER_DAY=5
AML_KYC_THRESHOLD=1000


# ── Email / Notifications (optional) ─────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@YOUR_DOMAIN
EMAIL_FROM_NAME=HOPEFX Trading
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true


# ── Payments / Stripe (optional) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=


# ── Monitoring (optional) ─────────────────────────────────────────────────────
SENTRY_DSN=
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password


# ── Feature flags ─────────────────────────────────────────────────────────────
FEATURE_COPY_TRADING=true
FEATURE_SOCIAL_FEED=true
FEATURE_LEADERBOARD=true
FEATURE_PROP_FIRM_TRACKER=true
FEATURE_AI_CHAT=true
FEATURE_GRAPHQL=true


# =============================================================================
# DATA LAYER — Gold Price APIs
# =============================================================================
# At least ONE gold price API key is required for live trading.
# Priority order: GoldAPI.io → Metals.dev → Metals-API → MetalpriceAPI → CommodityPriceAPI
#
# GoldAPI.io — https://www.goldapi.io/
#   Free: 100 req/month | Paid: up to 10,000 req/month
#   Provides bid/ask spread — highest quality source
GOLDAPI_IO_KEY=

# Metals.dev — https://metals.dev/
#   Free: 100 req/month | Paid: up to 100,000 req/month + WebSocket
METALS_DEV_KEY=

# Metals-API — https://metals-api.com/
#   Free: 100 req/month | Paid: up to 50,000 req/month
METALS_API_KEY=

# MetalpriceAPI — https://metalpriceapi.com/
#   Free: 100 req/month | Paid: up to 50,000 req/month
METALPRICEAPI_KEY=

# CommodityPriceAPI — https://commoditypriceapi.com/
#   Free: 100 req/month | Paid: up to 100,000 req/month
COMMODITY_PRICE_API_KEY=


# =============================================================================
# DATA LAYER — News & Sentiment APIs
# =============================================================================
# At least ONE news API key is recommended for sentiment features.
# All five can be active simultaneously for maximum coverage.
#
# Finnhub — https://finnhub.io/
#   Free: 60 req/min | Provides native sentiment scores for gold
#   Also used for: economic calendar (MacroCalendarEngine)
#   NOTE: FINNHUB_API_KEY is shared with the existing signal engine
FINNHUB_API_KEY=

# Financial Modeling Prep (FMP) — https://financialmodelingprep.com/
#   Free: 250 req/day | Gold-ticker-tagged news (GLD, IAU, XAUUSD)
FMP_API_KEY=

# NewsData.io — https://newsdata.io/
#   Free: 200 credits/day | Full-text gold search
NEWSDATA_IO_KEY=

# Alpha Vantage — https://www.alphavantage.co/
#   Free: 25 req/day | Pre-scored sentiment + ticker relevance
#   NOTE: ALPHA_VANTAGE_KEY is shared with the existing technical data feed
ALPHA_VANTAGE_KEY=

# NewsAPI.org — https://newsapi.org/
#   Free: 100 req/day (developer plan)
NEWSAPI_ORG_KEY=

# NewsAPI.ai — https://newsapi.ai/ (optional upgrade from NewsAPI.org)
#   Paid only | Richer entity extraction + native sentiment
NEWSAPI_AI_KEY=


# =============================================================================
# DATA LAYER — Macro Data
# =============================================================================
# FRED API key — https://fred.stlouisfed.org/docs/api/api_key.html
#   Free (no credit card required)
#   Without key: 120 req/day | With key: 500 req/day
#   Fetches: DXY, US10Y, US2Y, real10Y (TIPS), CPI, PCE, VIX, Fed Funds, M2
FRED_API_KEY=


# =============================================================================
# DATA LAYER — Dukascopy Historical Tick Data
# =============================================================================
# No API key required — Dukascopy provides free public tick data.
# Configure the local cache directory for downloaded bi5 files.
# Default: data/dukascopy_cache (relative to project root)
DUKASCOPY_CACHE_DIR=data/dukascopy_cache


# =============================================================================
# DATA LAYER — Tuning Parameters
# =============================================================================
# Data Quality Engine
DQE_MAX_JUMP_PCT=0.005          # reject ticks that move >0.5% in one tick
DQE_STALE_THRESHOLD_S=30.0      # mark source stale after 30s silence
DQE_LATENCY_WARN_MS=500.0       # warn when source latency >500ms
DQE_ANOMALY_ZSCORE=4.0          # z-score threshold for anomaly detection
DQE_CROSS_SOURCE_MAX_DIFF=0.003 # flag sources >0.3% from consensus

# Redis cache TTLs (seconds)
DL_TICK_TTL_S=30
DL_MICRO_TTL_S=5
DL_SENTIMENT_TTL_S=60
DL_MACRO_TTL_S=300
DL_CALENDAR_TTL_S=60

# Lineage store
LINEAGE_DB_PATH=data/lineage/lineage.db
LINEAGE_DB_URL=                          # Optional: postgresql://user:pass@host/db
LINEAGE_QUEUE_SIZE=50000                 # In-memory write queue depth
LINEAGE_BATCH_SIZE=500                   # Records per SQLite batch write
LINEAGE_FLUSH_S=2.0                      # Flush interval in seconds
LINEAGE_MAX_RECORDS=5000000              # Max rows before pruning oldest
LINEAGE_PRUNE_INTERVAL=3600             # Prune check interval (seconds)

# Redis cache TTLs (seconds) — additional keys
DL_TICK_HISTORY_MAX=10000               # Max ticks in sorted set history
DL_OHLCV_MAX_BARS=2000                  # Max OHLCV bars per timeframe in Redis
DL_QUALITY_TTL_S=30                     # Quality report cache TTL
DL_HEALTH_TTL_S=10                      # Feed health cache TTL

# Macro data directory (for CSV fallback when FRED is unavailable)
MACRO_DATA_DIR=data/macro

# News blackout windows around high-impact events (minutes)
NEWS_BLACKOUT_BEFORE_MIN=5
NEWS_BLACKOUT_AFTER_MIN=5

# Macro calendar refresh interval (seconds, default 1 hour)
CALENDAR_REFRESH_S=3600.0

# Microstructure engine
MICRO_WINDOW_TICKS=500                  # Rolling tick window size
MICRO_DELTA_WINDOW=100                  # Buy/sell pressure window
MICRO_PRESSURE_ALPHA=0.10               # Trade pressure EMA alpha
MICRO_SPREAD_ALPHA_F=0.10               # Spread fast EMA alpha
MICRO_SPREAD_ALPHA_S=0.02               # Spread slow EMA alpha
MICRO_VWAP_WINDOW=200                   # VWAP rolling window
MICRO_ZSCORE_WINDOW=100                 # Spread z-score window

# News sentiment engine
SENT_EMA_ALPHA=0.15                     # Sentiment EMA decay factor
SENT_WINDOW_H=1.0                       # Article lookback window (hours)
SENT_MAX_HISTORY=500                    # Max articles in memory
SENT_MIN_RELEVANCE=0.10                 # Minimum gold relevance to include

# Data Quality Engine — additional parameters
DQE_MIN_GOLD_PRICE=500.0               # Sanity floor for gold price (USD)
DQE_MAX_GOLD_PRICE=10000.0             # Sanity ceiling for gold price (USD)
DQE_MAX_SPREAD_PCT=0.01                # Max spread as % of mid (1%)
DQE_WINDOW_SIZE=200                    # Rolling window for anomaly detection
DQE_CONFIDENCE_DECAY=0.95              # Confidence EMA decay on error
DQE_MIN_CONFIDENCE=0.30                # Minimum source confidence floor

# Feed circuit breaker
FEED_CB_OPEN_ERRORS=5                  # Consecutive errors before circuit opens
FEED_CB_HALF_OPEN_S=60.0              # Seconds before half-open probe

# Normalization pipeline
NORM_PRICE_DECIMALS=4                  # Decimal places for price rounding
NORM_MIN_SPREAD=0.01                   # Minimum bid/ask spread (USD)
NORM_MAX_SPREAD_PCT=0.01               # Maximum spread as % of mid
NORM_GAP_MULTIPLIER=3.0               # Gap flag threshold (× rolling mean)
NORM_GAP_WINDOW=20                     # Rolling window for gap detection
NORM_MIN_GOLD_PRICE=100.0             # Drop OHLCV bars below this price

# Market replay engine
REPLAY_DEFAULT_SYMBOL=XAUUSD           # Default Dukascopy symbol
REPLAY_DEFAULT_TF_MIN=60               # Default timeframe in minutes
REPLAY_MAX_DAYS=365                    # Maximum replay range (days)
REPLAY_SPEED=0.0                       # 0=max speed, 1=real-time, N=N× real-time
