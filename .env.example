ONLINE_LEARNER_PERSIST=true                                # Persist online learner to disk


# =============================================================================
# ONLINE LEARNER TUNING
# =============================================================================
ONLINE_BUFFER_SIZE=500                 # Number of fills to buffer before refit
ONLINE_MIN_FILLS=50                    # Minimum fills required before blending
ONLINE_PRIMARY_WEIGHT=0.7              # Weight for primary model in blend
ONLINE_ONLINE_WEIGHT=0.3              # Weight for online learner in blend
ONLINE_ADAPTIVE_WEIGHTS=true           # Dynamically adjust blend weights
ONLINE_USE_ADWIN=true                  # Use ADWIN drift detector


# =============================================================================
# ANOMALY DETECTION
# =============================================================================
ANOMALY_WINDOW_SIZE=100                # Rolling window for anomaly detection
ANOMALY_CONTAMINATION=0.05             # Expected fraction of anomalous bars
ANOMALY_DOWN_WEIGHT=0.1               # Signal weight multiplier on anomalous bars
ANOMALY_REFIT_EVERY=500               # Refit anomaly model every N bars
ANOMALY_USE_LOF=false                  # Use Local Outlier Factor (vs IsolationForest)
ANOMALY_STORE_PATH=ml/saved_models/anomaly  # Path to persist anomaly model


# =============================================================================
# DEEP ENSEMBLE (LSTM/Transformer/TCN stacking)
# =============================================================================
DEEP_ENSEMBLE_MODEL_PATH=ml/saved_models/deep_ensemble.pt
DEEP_ENSEMBLE_META_PATH=ml/saved_models/deep_ensemble_meta.pkl
DEEP_ENSEMBLE_SCALER_PATH=ml/saved_models/deep_ensemble_scaler.pkl
DEEP_ENSEMBLE_SEQ_LEN=60               # Input sequence length for deep models
DEEP_ENSEMBLE_WEIGHT=0.3              # Blend weight for deep ensemble
DEEP_ENSEMBLE_OOS_GATE=true           # Gate on out-of-sample performance
DEEP_ENSEMBLE_PVAL_GATE=0.05          # p-value threshold for OOS gate


# =============================================================================
# DRIFT DETECTION
# =============================================================================
DRIFT_WINDOW=200                       # Rolling window for drift detection
DRIFT_Z_THRESHOLD=3.0                  # Z-score threshold to flag drift
DRIFT_BLOCK=true                       # Block signals when drift detected (false = warn only)
DRIFT_CHECK_EVERY_N_BARS=500           # Re-run drift check every N bars


# =============================================================================
# LIVE TRADING GATE
# =============================================================================
LIVE_GATE_PAPER_DAYS=30               # Minimum paper trading days before live
LIVE_GATE_MIN_TRADES=100              # Minimum trades in paper mode
LIVE_GATE_OOS_MIN_ACC=0.55            # Minimum OOS accuracy to unlock live
LIVE_GATE_OOS_MAX_PVAL=0.05           # Maximum p-value for OOS significance test


# =============================================================================
