# OpenTelemetry / Tracing
# Set to true and configure OTEL_EXPORTER above to enable distributed tracing.
# In development, use OTEL_EXPORTER=console to see spans in stdout without a collector.
OTEL_ENABLED=false
# OTEL_EXPORTER is declared above (line ~964) — do not redeclare here.
OTEL_SAMPLE_RATE=0.1
# Prometheus
PROMETHEUS_SCRAPE_INTERVAL_SECONDS=15

# Outbox relay
# Prop firm
PROP_FIRM_MODE=false
PROP_FIRM_CONFIG=config/prop_firm.json

# Kill switch
