ELITE_AM_CALENDAR_URL=https://calendly.com/hopefx-elite
ELITE_AM_SLACK=#elite-support

# ── Celery (optional — background task workers) ───────────────────────────────
# Broker and result backend use Redis DB 1 and 2 to avoid collision with the
# main app cache on DB 0.  Set REDIS_PASSWORD to match the redis service.
# CELERY_BROKER_URL=redis://:your_redis_password@redis:6379/1
# CELERY_RESULT_BACKEND=redis://:your_redis_password@redis:6379/2
# CELERY_CONCURRENCY=4
# CELERY_LOGLEVEL=info
# CELERY_TASK_ALWAYS_EAGER=false   # set true in tests to run tasks synchronously
# FLOWER_PORT=5555                 # Flower monitoring UI port
# FLOWER_BASIC_AUTH=admin:secret   # Flower basic auth (user:password)
