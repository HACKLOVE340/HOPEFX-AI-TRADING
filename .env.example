# HOPEFX AI Trading — Environment Variables
# Copy to .env and fill in values before starting.
#   cp .env.example .env

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECURITY_JWT_SECRET=CHANGE_ME_generate_a_random_48_char_secret
CONFIG_ENCRYPTION_KEY=CHANGE_ME_generate_a_random_48_char_key

# ── DATABASE ──────────────────────────────────────────────────────────────────
# SQLite (dev): sqlite:///hopefx.db
# Postgres (prod): postgresql://user:password@localhost:5432/hopefx
DATABASE_URL=sqlite:///hopefx.db

# Postgres credentials (required when using docker-compose)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=hopefx
POSTGRES_PASSWORD=CHANGE_ME_generate_a_strong_password
POSTGRES_DB=hopefx

# Grafana admin password (required when using docker-compose)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_generate_a_strong_password

# ── REDIS ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ── APPLICATION ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_BASE_URL=http://localhost:8000
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list of allowed CORS origins.
# Development default: localhost only.
# Production: set to your actual frontend domain(s), e.g.:
#   ALLOWED_ORIGINS=https://app.hopefx.io,https://hopefx.io
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── AUTH ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ── TRADING ───────────────────────────────────────────────────────────────────
BROKER_TYPE=paper
INITIAL_BALANCE=100000
COMMISSION=3.5
PAPER_USER_ID=paper
# Safety default — must be explicitly set to true to enable live auto-trading
SIGNAL_ENGINE_AUTO_TRADE=false

# ── KILL SWITCH ───────────────────────────────────────────────────────────────
# HMAC token required to deactivate an active trading halt via the API.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
HOPEFX_KILL_SWITCH_TOKEN=CHANGE_ME_generate_a_random_48_char_token

# ── RISK MANAGEMENT ───────────────────────────────────────────────────────────
RISK_MAX_POSITION_SIZE_PCT=0.02
RISK_MAX_DRAWDOWN_PCT=0.10
RISK_MAX_DAILY_LOSS_PCT=0.05

# ── AML GATE ──────────────────────────────────────────────────────────────────
AML_SINGLE_WITHDRAWAL_CAP=10000
AML_DAILY_WITHDRAWAL_LIMIT=50000
AML_MAX_WITHDRAWALS_PER_DAY=5
AML_KYC_THRESHOLD=1000
AML_RAPID_TURNAROUND_HOURS=1

# ── POSITION RECONCILER ───────────────────────────────────────────────────────
RECONCILER_INTERVAL_SECONDS=30

# ── ML TRAINING ───────────────────────────────────────────────────────────────
ML_SYMBOLS=GC=F,EURUSD=X
ML_PERIOD=2y
ML_MODEL_DIR=ml/saved_models

# ── EMAIL ─────────────────────────────────────────────────────────────────────
# Primary: SendGrid API (recommended — 95-99% inbox rate)
# Get API key from https://app.sendgrid.com/settings/api_keys
# Leave blank to fall back to raw SMTP (degraded deliverability)
SENDGRID_API_KEY=

# Webhook signature verification (ECDSA P-256 public key from SendGrid dashboard)
# Settings → Mail Settings → Event Webhook → Signature Verification → Public Key
# Leave blank to disable verification (NOT safe for production)
SENDGRID_WEBHOOK_PUBLIC_KEY=
# Set to false ONLY for local development when public key is not yet configured
SENDGRID_WEBHOOK_VERIFY=true

# Sender address shown in From: header (use a subdomain, e.g. mail.yourdomain.com)
SMTP_FROM=alerts@mail.hopefx.io

# Recipient address for system alerts
SMTP_TO=

# SMTP fallback — only used when SENDGRID_API_KEY is not set
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Legacy alias kept for backward compatibility (SMTP_FROM takes precedence)
FROM_EMAIL=noreply@hopefx.io

# ── PAYMENTS ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Flutterwave — primary checkout for West/Central Africa users
# Get from https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_SECRET_KEY=

# ── LIVE BROKER CREDENTIALS ───────────────────────────────────────────────────
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_ENVIRONMENT=practice
# Set to "false" to trade live (real money — use with caution)
OANDA_PRACTICE=true
# Comma-separated OANDA instrument codes
OANDA_INSTRUMENTS=XAU_USD,EUR_USD

# ── OPENAI (LLM Agent) ────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
# Model to use for strategy generation (gpt-4o recommended)
OPENAI_MODEL=gpt-4o
# Natural-language prompt for the LLM strategy generator
LLM_STRATEGY_PROMPT=Create a mean-reversion strategy for XAU_USD using Bollinger Bands and RSI. Target Sharpe > 1.5.

# ── RL AGENT ──────────────────────────────────────────────────────────────────
# Number of PPO training timesteps (50000 = ~5 min on CPU, 200000 = better)
RL_TIMESTEPS=50000
# Primary timeframe for candle data
TIMEFRAME=H1

# ── VECTOR STORE (ChromaDB) ───────────────────────────────────────────────────
# Directory for persistent ChromaDB storage
VECTORDB_DIR=data/vectordb

BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# ── ERROR TRACKING (Sentry) ───────────────────────────────────────────────────
# PRODUCTION SETUP:
#   1. Create a project at https://sentry.io
#   2. Go to Project Settings → Client Keys (DSN)
#   3. Copy the DSN and paste it below
#   4. Set APP_ENV=production so events are tagged correctly
#   5. Set SENTRY_RELEASE to the git SHA (CI injects this automatically):
#        SENTRY_RELEASE=$(git rev-parse --short HEAD)
#
# The following integrations are enabled automatically when SENTRY_DSN is set:
#   - FastAPI / Starlette (request tracing, endpoint tagging)
#   - SQLAlchemy (slow query detection)
#   - Redis (cache operation tracing)
#   - aiohttp (OANDA API call tracing)
#   - Logging (ERROR+ → Sentry issues, WARNING+ → breadcrumbs)
#
# ML fallback alert: if advanced_oos.pkl fails to load, a CRITICAL-level
# Sentry issue is fired automatically (capture_ml_fallback_event).
#
# Leave SENTRY_DSN blank to disable Sentry entirely (safe for development).
SENTRY_DSN=

# Fraction of requests traced for performance monitoring (0.0–1.0).
# Production recommendation: 0.05–0.1 to stay within quota.
# Set to 1.0 only during load testing or debugging.
SENTRY_TRACES_SAMPLE_RATE=0.1

# Fraction of traced requests that are CPU-profiled (0.0–1.0).
# Profiling requires sentry-sdk[profiling] and adds ~5% CPU overhead.
SENTRY_PROFILES_SAMPLE_RATE=0.05

# Override the environment tag in Sentry (defaults to APP_ENV).
# Valid values: development | staging | production
SENTRY_ENVIRONMENT=

# Release string shown in Sentry issue timelines.
# Set by CI pipeline: git rev-parse --short HEAD
# Example: SENTRY_RELEASE=a1b2c3d
SENTRY_RELEASE=

# ── MOBILE PUSH (Firebase Cloud Messaging) ────────────────────────────────────
# Get from Firebase Console → Project Settings → Cloud Messaging → Server key
# Leave blank to run in log-only mode (no real pushes sent)
FIREBASE_SERVER_KEY=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ── FEATURE FLAGS ─────────────────────────────────────────────────────────────
# All flags are read by config/feature_flags.py at runtime.
# Set to "false" / "0" / "no" / "off" to disable; any other value enables.
# Defaults shown below match the hard-coded defaults in config/feature_flags.py.

# ── Core Trading ──────────────────────────────────────────────────────────────
FEATURE_STRATEGY_MANAGER=true
FEATURE_PAPER_TRADING=true
# Safety default — must be explicitly set to true to enable live order execution
FEATURE_LIVE_TRADING=false
FEATURE_RISK_MANAGER=true

# ── Strategies ────────────────────────────────────────────────────────────────
FEATURE_STRATEGY_MA_CROSSOVER=true
FEATURE_STRATEGY_EMA_CROSSOVER=true
FEATURE_STRATEGY_BOLLINGER=true
FEATURE_STRATEGY_BREAKOUT=true
FEATURE_STRATEGY_MACD=true
FEATURE_STRATEGY_RSI=true
FEATURE_STRATEGY_SMC_ICT=true
FEATURE_STRATEGY_MEAN_REVERSION=true
FEATURE_STRATEGY_STOCHASTIC=true
FEATURE_STRATEGY_BRAIN=true

# ── Analysis & Order Flow ─────────────────────────────────────────────────────
FEATURE_ORDER_FLOW_ANALYSIS=true
FEATURE_ORDER_FLOW_ADVANCED=true
FEATURE_INSTITUTIONAL_FLOW=true
FEATURE_ORDER_FLOW_DASHBOARD=true
FEATURE_MARKET_ANALYSIS=true
FEATURE_MARKET_SCANNER=true
FEATURE_CANDLESTICK_PATTERNS=true
FEATURE_DARK_POOL_DETECTION=true

# ── Data Feeds ────────────────────────────────────────────────────────────────
FEATURE_TIME_AND_SALES=true
FEATURE_DEPTH_OF_MARKET=true
FEATURE_MARKET_DATA_STREAMING=true

# ── News & Sentiment ──────────────────────────────────────────────────────────
FEATURE_NEWS_SENTIMENT=true
FEATURE_ECONOMIC_CALENDAR=true
FEATURE_GEOPOLITICAL_RISK=true

# ── Machine Learning ──────────────────────────────────────────────────────────
# Off by default until models reach production accuracy threshold
FEATURE_ML_PREDICTIONS=false
FEATURE_ML_FEATURE_ENGINEERING=true

# ── Research integration path (Phases 1–4) ───────────────────────────────────
# Phase 1: MTF fusion — H4/D1 regime features appended at inference (default: on)
FEATURE_MTF_FUSION=true
# Phase 2: Anomaly weighting — down-weight signals during anomalous conditions (default: off)
FEATURE_ANOMALY_WEIGHTING=false
# Phase 3: Online learning — IncrementalXGBoost updates on confirmed fills (default: off)
FEATURE_ONLINE_LEARNING=false
# Phase 4: Deep ensemble — LSTM/Transformer/TCN stacking (default: off)
FEATURE_DEEP_ENSEMBLE=false

# ── Charting ──────────────────────────────────────────────────────────────────
FEATURE_CHART_ENGINE=true
FEATURE_DRAWING_TOOLS=true

# ── Backtesting ───────────────────────────────────────────────────────────────
FEATURE_BACKTESTING=true
FEATURE_WALK_FORWARD=true

# ── Brokers ───────────────────────────────────────────────────────────────────
FEATURE_BROKER_OANDA=true
FEATURE_BROKER_ALPACA=true
FEATURE_BROKER_BINANCE=true
FEATURE_BROKER_MT5=true
FEATURE_BROKER_INTERACTIVE_BROKERS=true

# ── Social & Copy Trading ─────────────────────────────────────────────────────
FEATURE_SOCIAL_TRADING=true
FEATURE_COPY_TRADING=true

# ── Monetisation ──────────────────────────────────────────────────────────────
FEATURE_SUBSCRIPTIONS=true
FEATURE_WHITE_LABEL=true
FEATURE_ENTERPRISE=true
FEATURE_PAYMENTS=true

# ── Mobile ────────────────────────────────────────────────────────────────────
FEATURE_MOBILE_API=true
FEATURE_PUSH_NOTIFICATIONS=true

# ── Admin & Monitoring ────────────────────────────────────────────────────────
FEATURE_ADMIN_DASHBOARD=true
FEATURE_ANALYTICS=true

# ── Experimental / Unreleased (all off by default) ───────────────────────────
# Research notebook tooling
FEATURE_RESEARCH=false
# SHAP/LIME explainability for ML decisions
FEATURE_EXPLAINABILITY=false
# Automated transparency / audit reports
FEATURE_TRANSPARENCY=false
# Multi-user team workspaces
FEATURE_TEAMS=false
# No-code strategy builder
FEATURE_NOCODE=false
# Tick-by-tick market replay
FEATURE_REPLAY=false

