# AML
AML_RAPID_TURNAROUND_HOURS=24

# General API / App settings
API_BASE_URL=http://localhost:8000
API_DEBUG=false
API_KEY_ENCRYPTION=false
# One worker per CPU. The container is capped at API_CPUS=1.0 (see the resource
# section above and docker-compose.yml), and each uvicorn worker is a full
# separate copy of the app — measured at 296 MiB resident from imports alone,
# before any model is loaded.
#
# This shipped as 4: four copies competing for one core, all of them racing a
# healthcheck with start_period=60s and timeout=10s. The two values live 380
# lines apart in this file, which is how they came to disagree. The symptom is
# an app container that stays "Up (unhealthy)" indefinitely, with uvicorn
# logging "Child process [N] died" between router registrations from the
# workers that are still alive — and nginx never starting, because it waits on
# the app being healthy.
#
# Raise this only alongside API_CPUS, and keep workers <= CPUs.
API_WORKERS=1

# Chart-bot AI analyses allowed per user per minute (POST /api/trading/ai-analysis).
# Each one loads 200 bars and runs a model inference, so this is a real cost:
# the endpoint previously had no limit at all and a drag across the chart issued
# one uncached fetch per click into the shared executor pool.
AI_ANALYSIS_RATE_PER_MIN=30
AUTH_TOKEN=
# Antivirus scan interval
AV_SCAN_INTERVAL=3600

