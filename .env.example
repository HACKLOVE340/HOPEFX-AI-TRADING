# =============================================================================
# HOPEFX AI Trading — Environment Variables
# =============================================================================
# Copy to .env and fill in ALL values before starting.
#   cp .env.example .env
#
# For GoDaddy VPS: run deploy.sh — it writes .env automatically.
#
# Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================


# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production
APP_BASE_URL=https://YOUR_DOMAIN


# ── Security (REQUIRED — generate unique values, never reuse) ─────────────────
SECURITY_JWT_SECRET=CHANGE_ME_generate_64_char_hex_secret
CONFIG_ENCRYPTION_KEY=CHANGE_ME_generate_48_char_urlsafe_key
HOPEFX_KILL_SWITCH_TOKEN=CHANGE_ME_generate_64_char_hex_token
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60


# ── Database ──────────────────────────────────────────────────────────────────
# Production: PostgreSQL (docker compose provides the db service)
DATABASE_URL=postgresql+asyncpg://hopefx:CHANGE_ME_db_password@db:5432/hopefx
POSTGRES_USER=hopefx
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=hopefx
DB_HOST=db
DB_PASSWORD=CHANGE_ME_db_password
# Development only (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./hopefx.db


# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password


# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=https://YOUR_DOMAIN,https://www.YOUR_DOMAIN
MOBILE_CORS_ORIGINS=


# ── Broker ────────────────────────────────────────────────────────────────────
# Start with paper. Switch to live only after thorough testing.
BROKER_TYPE=paper
INITIAL_BALANCE=100000
COMMISSION=3.5
PAPER_USER_ID=paper
SIGNAL_ENGINE_AUTO_TRADE=false

# OANDA (required when BROKER_TYPE=oanda)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# MetaTrader 5 (required when BROKER_TYPE=mt5)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# cTrader (required when BROKER_TYPE=ctrader)
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCOUNT_ID=


# ── Risk management ───────────────────────────────────────────────────────────
RISK_MAX_POSITION_SIZE_PCT=0.05
RISK_MAX_DRAWDOWN_PCT=0.10
RISK_MAX_DAILY_LOSS_PCT=0.05
RISK_KELLY_FRACTION=0.25
RISK_MIN_RR=2.0


# ── ML / Signal engine ────────────────────────────────────────────────────────
ML_MIN_TRADE_PROB=0.58
SL_ATR_MULT=1.5
TP_ATR_MULT=3.0


# ── AML / Compliance ──────────────────────────────────────────────────────────
AML_SINGLE_WITHDRAWAL_CAP=10000
AML_DAILY_WITHDRAWAL_LIMIT=50000
AML_MAX_WITHDRAWALS_PER_DAY=5
AML_KYC_THRESHOLD=1000


# ── Email / Notifications (optional) ─────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@YOUR_DOMAIN
EMAIL_FROM_NAME=HOPEFX Trading
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true


# ── Payments / Stripe (optional) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=


# ── Monitoring (optional) ─────────────────────────────────────────────────────
SENTRY_DSN=
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password


# ── Feature flags ─────────────────────────────────────────────────────────────
FEATURE_COPY_TRADING=true
FEATURE_SOCIAL_FEED=true
FEATURE_LEADERBOARD=true
FEATURE_PROP_FIRM_TRACKER=true
FEATURE_AI_CHAT=true
FEATURE_GRAPHQL=true
