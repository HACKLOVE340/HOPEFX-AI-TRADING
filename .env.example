# HOPEFX AI Trading — Environment Variables
# Copy to .env and fill in values before starting.
#   cp .env.example .env

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECURITY_JWT_SECRET=CHANGE_ME_generate_a_random_48_char_secret
CONFIG_ENCRYPTION_KEY=CHANGE_ME_generate_a_random_48_char_key

# ── DATABASE ──────────────────────────────────────────────────────────────────
# SQLite (dev): sqlite:///hopefx.db
# Postgres (prod): postgresql://user:password@localhost:5432/hopefx
DATABASE_URL=sqlite:///hopefx.db

# Postgres credentials (required when using docker-compose)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=hopefx
POSTGRES_PASSWORD=CHANGE_ME_generate_a_strong_password
POSTGRES_DB=hopefx

# Grafana admin password (required when using docker-compose)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_generate_a_strong_password

# ── REDIS ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ── APPLICATION ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_BASE_URL=http://localhost:8000
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list of allowed CORS origins.
# Development default: localhost only.
# Production: set to your actual frontend domain(s), e.g.:
#   ALLOWED_ORIGINS=https://app.hopefx.io,https://hopefx.io
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── AUTH ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ── TRADING ───────────────────────────────────────────────────────────────────
BROKER_TYPE=paper
INITIAL_BALANCE=100000
COMMISSION=3.5
PAPER_USER_ID=paper
# Safety default — must be explicitly set to true to enable live auto-trading
SIGNAL_ENGINE_AUTO_TRADE=false

# ── KILL SWITCH ───────────────────────────────────────────────────────────────
# HMAC token required to deactivate an active trading halt via the API.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
HOPEFX_KILL_SWITCH_TOKEN=CHANGE_ME_generate_a_random_48_char_token

# ── RISK MANAGEMENT ───────────────────────────────────────────────────────────
RISK_MAX_POSITION_SIZE_PCT=0.02
RISK_MAX_DRAWDOWN_PCT=0.10
RISK_MAX_DAILY_LOSS_PCT=0.05

# ── AML GATE ──────────────────────────────────────────────────────────────────
AML_SINGLE_WITHDRAWAL_CAP=10000
AML_DAILY_WITHDRAWAL_LIMIT=50000
AML_MAX_WITHDRAWALS_PER_DAY=5
AML_KYC_THRESHOLD=1000
AML_RAPID_TURNAROUND_HOURS=1

# ── POSITION RECONCILER ───────────────────────────────────────────────────────
RECONCILER_INTERVAL_SECONDS=30

# ── ML TRAINING ───────────────────────────────────────────────────────────────
ML_SYMBOLS=GC=F,EURUSD=X
ML_PERIOD=2y
ML_MODEL_DIR=ml/saved_models

# ── EMAIL ─────────────────────────────────────────────────────────────────────
# Primary: SendGrid API (recommended — 95-99% inbox rate)
# Get API key from https://app.sendgrid.com/settings/api_keys
# Leave blank to fall back to raw SMTP (degraded deliverability)
SENDGRID_API_KEY=

# Webhook signature verification (ECDSA P-256 public key from SendGrid dashboard)
# Settings → Mail Settings → Event Webhook → Signature Verification → Public Key
# Leave blank to disable verification (NOT safe for production)
SENDGRID_WEBHOOK_PUBLIC_KEY=
# Set to false ONLY for local development when public key is not yet configured
SENDGRID_WEBHOOK_VERIFY=true

# Sender address shown in From: header (use a subdomain, e.g. mail.yourdomain.com)
SMTP_FROM=alerts@mail.hopefx.io

# Recipient address for system alerts
SMTP_TO=

# SMTP fallback — only used when SENDGRID_API_KEY is not set
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Legacy alias kept for backward compatibility (SMTP_FROM takes precedence)
FROM_EMAIL=noreply@hopefx.io

# ── PAYMENTS ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Flutterwave — primary checkout for West/Central Africa users
# Get from https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_SECRET_KEY=

# ── LIVE BROKER CREDENTIALS ───────────────────────────────────────────────────
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_ENVIRONMENT=practice
# Set to "false" to trade live (real money — use with caution)
OANDA_PRACTICE=true
# Comma-separated OANDA instrument codes
OANDA_INSTRUMENTS=XAU_USD,EUR_USD

# ── OPENAI (LLM Agent) ────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
# Model to use for strategy generation (gpt-4o recommended)
OPENAI_MODEL=gpt-4o
# Natural-language prompt for the LLM strategy generator
LLM_STRATEGY_PROMPT=Create a mean-reversion strategy for XAU_USD using Bollinger Bands and RSI. Target Sharpe > 1.5.

# ── RL AGENT ──────────────────────────────────────────────────────────────────
# Number of PPO training timesteps (50000 = ~5 min on CPU, 200000 = better)
RL_TIMESTEPS=50000
# Primary timeframe for candle data
TIMEFRAME=H1

# ── VECTOR STORE (ChromaDB) ───────────────────────────────────────────────────
# Directory for persistent ChromaDB storage
VECTORDB_DIR=data/vectordb

BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# ── ERROR TRACKING (Sentry) ───────────────────────────────────────────────────
# Get DSN from https://sentry.io → Project Settings → Client Keys
# Leave blank to disable Sentry (safe for development)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── MOBILE PUSH (Firebase Cloud Messaging) ────────────────────────────────────
# Get from Firebase Console → Project Settings → Cloud Messaging → Server key
# Leave blank to run in log-only mode (no real pushes sent)
FIREBASE_SERVER_KEY=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ── FEATURE FLAGS ─────────────────────────────────────────────────────────────
FEATURE_ML_PREDICTIONS=true
FEATURE_SOCIAL_TRADING=true
FEATURE_COPY_TRADING=true
FEATURE_PAPER_TRADING=true
FEATURE_LIVE_TRADING=false
FEATURE_BACKTESTING=true
FEATURE_MARKET_SCANNER=true
FEATURE_ORDER_FLOW=true
FEATURE_NEWS_SENTIMENT=true
FEATURE_EXPLAINABILITY=true
FEATURE_TRANSPARENCY=true
FEATURE_TEAMS=true
FEATURE_NOCODE_BUILDER=true
FEATURE_REPLAY_ENGINE=true
