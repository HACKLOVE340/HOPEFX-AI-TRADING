# World Monitor — open-source geopolitical map dashboard
# GitHub: https://github.com/koala73/worldmonitor
# Public instance: https://worldmonitor.app
#
# World Monitor public REST API — no key required for web access.
# Reference: https://worldmonitor.app/docs/api-reference
# Leave blank to use the public instance (https://worldmonitor.app).
# Set only when running a self-hosted instance.
WORLDMONITOR_API_URL=

# Set to false to disable all geopolitical data fetching (World Monitor, GDELT,
# ACLED, ReliefWeb). Suppresses the "All geopolitical data sources unavailable"
# warning when outbound HTTPS to those services is blocked or the feature is not needed.
ENABLE_GEOPOLITICAL_RISK=true

# Remaining env vars found in audit (Phase 2)
# Must cover every instrument the trading terminal offers in its symbol
# dropdown (frontend/src/pages/Trading.tsx). This line omitted ETHUSD while the
# UI listed ETH/USD, so selecting it returned 400 "not in the permitted
# instrument list". No spaces after the commas — entries are stripped now, but
# keep it tight. Enforced by tests/unit/test_instrument_allowlist_agrees.py.
ALLOWED_SYMBOLS=XAUUSD,EURUSD,GBPUSD,USDJPY,BTCUSD,ETHUSD,AUDUSD,USDCHF
