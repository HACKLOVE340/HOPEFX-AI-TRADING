DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1424287263206150265/TARQ2mBGJAxCsghxRQ4F2Utky29-pDgOcCxlDtOjjZzEwjU65qLVuqt30fi--EJQ0FLA
# Separate webhook for system alerts (optional — defaults to DISCORD_WEBHOOK_URL)
