# =============================================================================
# HOPEFX AI Trading — Environment Variables
# =============================================================================
# Copy to .env and fill in ALL values before starting.
#   cp .env.example .env
#
# For GoDaddy VPS: run deploy.sh — it writes .env automatically.
#
# Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================


# ── Application ───────────────────────────────────────────────────────────────
# APP_ENV is the primary environment switch and the one ~100 call sites read.
# ENVIRONMENT (further down, under APPLICATION IDENTITY) is a legacy alias kept
# for the few places that still read it; where both are consulted APP_ENV wins.
# Keep them in agreement. They drifted apart in code once and cost a Secure
# cookie flag on token rotation (see docs/HARDENING_BACKLOG.md, S-07).
APP_ENV=production
APP_BASE_URL=https://YOUR_DOMAIN

# Domain used by nginx/entrypoint.sh to render nginx.conf.template.
# Must match APP_BASE_URL (without https://).
HOPEFX_DOMAIN=YOUR_DOMAIN


# ── Security (REQUIRED — generate unique values, never reuse) ─────────────────
SECURITY_JWT_SECRET=CHANGE_ME_generate_64_char_hex_secret
CONFIG_ENCRYPTION_KEY=CHANGE_ME_generate_48_char_urlsafe_key
# Field-level database encryption key — AES-256-GCM.  Generate with:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DB_ENCRYPTION_KEY=CHANGE_ME_generate_32byte_urlsafe_b64_key
HOPEFX_KILL_SWITCH_TOKEN=CHANGE_ME_generate_64_char_hex_token
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ── Bootstrap seed account credentials ───────────────────────────────────────
# Passwords for the three default accounts created by scripts/bootstrap_dev.py
# and scripts/bootstrap_prod.py on first run.
#
# In development: bootstrap_dev.py auto-generates these and writes them to .env.
# In production:  set strong unique values here BEFORE running bootstrap_prod.py.
#   Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#
# Accounts created:
#   superadmin@hopefx.io  role=superadmin  → /superadmin
#   admin@hopefx.io       role=admin       → /audit
#   trader@hopefx.io      role=trader      → /dashboard
#
# ⚠  Change all three passwords immediately after first login.
# ⚠  Never commit this file with real passwords.
# The addresses were listed in the comment above but declared nowhere, while
# scripts/bootstrap_prod.py reads BOOTSTRAP_SUPERADMIN_EMAIL and exits with
# "Set it in .env before running this script" when it is empty — pointing at a
# variable this file did not have. Declared here so that instruction can be
# followed. Change them to your own addresses before the first deploy.
BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@hopefx.io
BOOTSTRAP_SUPERADMIN_PASSWORD=CHANGE_ME_generate_strong_superadmin_password
BOOTSTRAP_ADMIN_EMAIL=admin@hopefx.io
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_generate_strong_admin_password
BOOTSTRAP_TRADER_EMAIL=trader@hopefx.io
BOOTSTRAP_TRADER_PASSWORD=CHANGE_ME_generate_strong_trader_password


# ── Database ──────────────────────────────────────────────────────────────────
# Production: PostgreSQL (docker compose provides the db service)
DATABASE_URL=postgresql+asyncpg://hopefx:CHANGE_ME_db_password@postgres:5432/hopefx
POSTGRES_USER=hopefx
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=hopefx
DB_HOST=postgres
DB_PASSWORD=CHANGE_ME_db_password
# Development only (SQLite — default when DATABASE_URL is unset):
# DATABASE_URL=sqlite:///hopefx.db


# ── Redis ─────────────────────────────────────────────────────────────────────
# Single-node (default / dev):
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# TLS enforcement — set true to auto-upgrade redis:// → rediss:// at runtime.
# In production, prefer setting REDIS_URL=rediss://... directly.
# IS_FORCE_TLS and REDIS_FORCE_TLS are both accepted (IS_FORCE_TLS takes precedence).
IS_FORCE_TLS=true
REDIS_FORCE_TLS=true

# TLS certificate paths (leave blank to use system CA bundle):
REDIS_TLS_CA_CERT=
REDIS_TLS_CLIENT_CERT=
REDIS_TLS_CLIENT_KEY=
# Set true ONLY in controlled test environments with self-signed certs:
REDIS_TLS_SKIP_VERIFY=false

# ── Redis Sentinel (production HA — uncomment and set to enable) ──────────────
# When REDIS_SENTINEL_HOSTS is set, REDIS_URL is ignored.
# Run: docker compose -f docker-compose.yml -f docker-compose.sentinel.yml up -d
#
# REDIS_SENTINEL_HOSTS=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
# REDIS_SENTINEL_MASTER=hopefx-master


# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# CORS — must match the exact origin(s) the React SPA is served from.
# In production: your HTTPS domain(s). The app will sys.exit(1) at startup
# if this contains http:// or localhost in production mode.
# Must stay in sync with APP_BASE_URL and HOPEFX_DOMAIN above.
ALLOWED_ORIGINS=https://YOUR_DOMAIN,https://www.YOUR_DOMAIN

MOBILE_CORS_ORIGINS=

# ── Frontend (Vite) environment variables ─────────────────────────────────────
# These are baked into the React bundle at build time (VITE_ prefix required).
# In development the Vite dev server proxies /api and /ws to localhost:8000,
# so all three can be left blank for local dev.
# In production (Docker / VPS) leave them blank — the React app uses relative
# URLs (/api, /ws/live) which nginx proxies to the backend on the same origin.
# Only set these if the frontend and backend are on DIFFERENT origins
# (e.g. a CDN-hosted SPA talking to a separate API subdomain).
#
# Set them in the frontend section near the bottom of this file, not here —
# these three lines are commented out and are documentation only. They are
# build-time values (see that section); a rebuild is required after changing
# them.
#
# VITE_API_URL=https://api.YOUR_DOMAIN
# VITE_WS_URL=wss://api.YOUR_DOMAIN
# VITE_NUCLEAR_WS_URL=wss://api.YOUR_DOMAIN/ws/nuclear


# ── Live price streaming — NuclearStreamer (broker-free WebSocket feed) ────────
# OANDA is NEVER used for price streaming. It is execution-only.
# Set at least one key below for live XAUUSD WebSocket ticks.
# All configured sources run concurrently; anomalous ticks are discarded.

# Finnhub WebSocket — https://finnhub.io/  (free tier; symbol: OANDA:XAU_USD)
# Shared with the sentiment / news signal engine.
FINNHUB_API_KEY=

# Twelve Data WebSocket — https://twelvedata.com/  (free tier; symbol: XAU/USD)
TWELVE_API_KEY=

# Polygon.io Forex WebSocket — https://polygon.io/  (Currencies plan; fastest)
# Symbol: C.XAU/USD  — sub-50 ms latency on paid tier.
POLYGON_API_KEY=


# ── Broker ────────────────────────────────────────────────────────────────────
# Start with paper. Switch to live only after thorough testing.
BROKER_TYPE=paper
PAPER_TRADING=true
INITIAL_BALANCE=100000
COMMISSION=3.5
PAPER_USER_ID=paper
SIGNAL_ENGINE_AUTO_TRADE=false

# OANDA (execution only — order placement, account queries, position management)
# NOT used for price streaming. Live ticks come from NuclearStreamer above.
# Account ID format: 101-XXX-XXXXXXXX-XXX  (e.g. 101-001-12345678-001)
# Obtain from OANDA portal → My Account → Manage Funds → Account Details
# CANONICAL — set this one (Personal Access Token from OANDA portal)
OANDA_API_KEY=
# CANONICAL — 101-XXX-XXXXXXXX-XXX
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice             # CANONICAL — practice | live

# MetaTrader 5 (required when BROKER_TYPE=mt5)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# cTrader (required when BROKER_TYPE=ctrader)
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCOUNT_ID=


# ── ML safety gates ───────────────────────────────────────────────────────────
# These decide whether the system will trade on a model it should not trust.
# They were absent from this template entirely, so an operator building a .env
# the documented way could neither find nor verify them and both ran on their
# code defaults invisibly. See docs/HARDENING_BACKLOG.md S11-02.
#
# true (default) = a stale model raises and the pre-trade gate blocks the trade.
# false          = degrade to a neutral signal and keep trading. Only set this
#                  if you are deliberately accepting the risk.
STALE_MODEL_BLOCK=true
# Master switch for live (non-paper) order placement. Leave false until the
# live-trading gate in docs/live_trading_gate.md has been signed off.
LIVE_TRADING_ENABLED=false

# ── Risk / execution limits that were also undocumented ───────────────────────
# FIA 2024 mandatory pre-trade controls (risk/fia_compliance.py).
FIA_MAX_ORDER_SIZE=100
FIA_MAX_INTRADAY_POSITION=500
# Max age of the tick the SL/TP monitor may act on, in seconds. A stalled feed
# must not trigger a stop against a price that no longer exists.
SLTP_MAX_TICK_AGE_S=5
# Emergency drawdown halt for the master control loop (fraction, not percent).
MCC_EMERGENCY_DD_PCT=0.10
# Allow automatic fallback to the paper broker when the configured broker is
# unavailable. Leave false in production: silently trading on paper while you
# believe you are live is worse than failing to start.
FALLBACK_TO_PAPER=false
# Raise (rather than warn) when the paper runner sees a stale price.
PAPER_RAISE_ON_STALE=true


# ── Risk management ───────────────────────────────────────────────────────────
RISK_MAX_POSITION_SIZE_PCT=0.05
RISK_MAX_DRAWDOWN_PCT=0.10
RISK_MAX_DAILY_LOSS_PCT=0.05
RISK_KELLY_FRACTION=0.25
RISK_MIN_RR=2.0

# ── Constitutional invariant enforcement (see docs/INVARIANT_ROLLOUT.md) ──────
# off      = checks do not run
# monitor  = checks run and LOG violations but never block (safe default)
# enforce  = a CONSTITUTIONAL/CRITICAL violation blocks the trade / trips the
#            kill switch. Only flip to enforce after a clean soak in monitor.
HOPEFX_INVARIANT_MODE=monitor
# Staged rollout (docs/INVARIANT_ROLLOUT.md): keep the global mode at monitor and
# enforce individual checks; everything not listed stays observe-only. Removing a
# kind from this list is the instant rollback (no deploy).
#
# ENFORCED NOW — the "can only refuse a single order, never halt the desk" pair:
#   order_authorization — refuses any order missing a risk-approval token / decision id.
#   pre_trade           — refuses a bad order (non-finite price/conf, crossed book,
#                         stale tick, low confidence).
#
# PROMOTE AFTER A CLEAN SOAK — reconciliation, ledger. These are HIGHEST BLAST
# RADIUS: a book-value/PnL or capital-equation breach trips the kill switch and
# halts ALL trading. Leave them in monitor (they still log to /health/invariants)
# until counters.halts_signalled stays clean across a soak; then append them here:
#   HOPEFX_INVARIANT_ENFORCE_KINDS=order_authorization,pre_trade,reconciliation,ledger
# Keep RECONCILER_DRIFT_VALUE sane and HOPEFX_INVARIANT_FAIL_CLOSED=0 before doing so.
HOPEFX_INVARIANT_ENFORCE_KINDS=order_authorization,pre_trade
# 1 = a bug *inside* a checker also blocks (fail-closed). Keep 0 during rollout
# so a checker bug cannot halt the desk.
HOPEFX_INVARIANT_FAIL_CLOSED=0
# Tunable thresholds for the wired invariants (0 disables where noted):
RISK_MAX_TICK_STALENESS_S=5.0
RISK_MAX_SYMBOL_EXPOSURE_USD=1000000.0
RISK_APPROVED_VAR_USD=0
# Human-approval (four-eyes) gate: orders with notional >= this USD value must
# carry an `approved_by` (a named human). 0 = disabled. To activate, set a
# threshold AND add `human_approval` to HOPEFX_INVARIANT_ENFORCE_KINDS.
RISK_HUMAN_APPROVAL_NOTIONAL_USD=0


# ── ML / Signal engine ────────────────────────────────────────────────────────
ML_MIN_TRADE_PROB=0.58
SL_ATR_MULT=1.5
TP_ATR_MULT=3.0


# ── SniperEntryEngine ─────────────────────────────────────────────────────────
# Refines SMC brain signals into precision LIMIT orders using HTF Order Block
# detection + LTF (M5) BOS/CHoCH confirmation + displacement FVG CE placement.
# Set SNIPER_ENABLED=false to revert to market orders (brain signal only).
SNIPER_ENABLED=true

# Higher timeframe for OB detection and trend confirmation (H1 or H4)
SNIPER_HTF_TIMEFRAME=H1

# Lower timeframe for BOS/CHoCH + displacement candle drill-down (M5 or M15)
SNIPER_LTF_TIMEFRAME=M5

# Number of LTF bars to fetch for M5 analysis
SNIPER_LTF_BARS=100

# HTF Order Block search window (bars)
SNIPER_OB_LOOKBACK=20

# Swing pivot neighbour count for BOS/CHoCH detection
SNIPER_PIVOT_N=3

# Minimum candle body / ATR ratio to qualify as a displacement candle
SNIPER_DISPLACEMENT_MULT=1.5

# ATR multiples added beyond the OB extreme for stop-loss placement
SNIPER_SL_ATR_BUFFER=0.5

# Minimum risk:reward ratio for take-profit placement
SNIPER_TP_RR=2.0

# Reject entry when bid/ask spread exceeds this many price points
SNIPER_MAX_SPREAD_POINTS=30

# Confidence multiplier applied to the brain signal on a confirmed sniper setup
SNIPER_CONFIDENCE_BOOST=1.20


# ── AdaptiveEdgeSelector ──────────────────────────────────────────────────────
# Analyses live indicators each bar and selects ONE edge: sniper, scalper,
# grid, or skip.  Overrides the brain's default regime→strategy routing table.
# Set EDGE_SELECTOR_ENABLED=false to revert to the default routing table.
EDGE_SELECTOR_ENABLED=true

# Minimum confidence % required to open any trade (0–100)
EDGE_SELECTOR_MIN_CONFIDENCE=80

# ITOS cone score floor — below this, sniper and grid are rejected
EDGE_SELECTOR_CONE_THRESHOLD=0.70

# ADX threshold for trend regime classification
EDGE_SELECTOR_ADX_TREND=25.0

# ADX ceiling below which regime is classified as choppy → skip
EDGE_SELECTOR_ADX_CHOPPY=15.0

# RSI overbought / oversold levels for scalper edge
EDGE_SELECTOR_RSI_OB=70
EDGE_SELECTOR_RSI_OS=30

# ATR multipliers for stop-loss and take-profit placement
EDGE_SELECTOR_ATR_SL_MULT=2.0
EDGE_SELECTOR_ATR_TP_MULT=4.0

# Maximum lot size — capital protection hard cap
EDGE_SELECTOR_MAX_LOT=0.01

# Grid recovery settings
EDGE_SELECTOR_GRID_MAX_LAYERS=4
EDGE_SELECTOR_GRID_BE_PIPS=20
# Drawdown % that triggers grid cooldown (no new layers)
EDGE_SELECTOR_GRID_DD_COOLDOWN=5.0


# ── AML / Compliance ──────────────────────────────────────────────────────────
AML_SINGLE_WITHDRAWAL_CAP=10000
AML_DAILY_WITHDRAWAL_LIMIT=50000
AML_MAX_WITHDRAWALS_PER_DAY=5
AML_KYC_THRESHOLD=1000


# ── Email / Notifications (optional) ─────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@YOUR_DOMAIN
EMAIL_FROM_NAME=HOPEFX Trading
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true


# ── Payments / Stripe (optional) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Hard cap on a single checkout amount (USD) — rejects oversized charges.
MAX_CHECKOUT_AMOUNT_USD=1000000

# ── New user trial ────────────────────────────────────────────────────────────
# Days of Starter-tier trial granted to every new user on registration.
# Set to 0 to disable the trial and start all users on the Free tier.
NEW_USER_TRIAL_DAYS=14


# ── Crypto payment webhooks ───────────────────────────────────────────────────
# HMAC-SHA256 secret shared with your crypto payment processor (BitPay,
# Coinbase Commerce, or custom).  Required in production — startup will fail
# without it when APP_ENV=production.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
CRYPTO_WEBHOOK_SECRET=CHANGE_ME_generate_64_char_hex_secret
# Set to "false" ONLY in development to bypass HMAC verification.
CRYPTO_WEBHOOK_VERIFY=true


# ── Flutterwave (optional — African payment gateway) ─────────────────────────
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=


# ── Monitoring (optional) ─────────────────────────────────────────────────────
SENTRY_DSN=
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# ── Alertmanager ──────────────────────────────────────────────────────────────
# Every channel below is optional and independent. A channel whose variables
# are unset is omitted from the generated alertmanager.yml, and the container
# logs which ones are armed at startup:
#
#     alertmanager: telegram=1 email=off pagerduty=off
#
# If none is configured, alerts are grouped and then DROPPED, and the container
# says so in capitals. Critical routes here carry drawdown breaches, circuit
# breaker trips and P&L reconciliation failures — configure at least one.
#
# Telegram channel for critical alerts (same bot as TELEGRAM_BOT_TOKEN or separate).
# Both are required together; a token with chat_id 0 leaves Telegram off.
# Telegram bot token for Alertmanager
ALERTMANAGER_TELEGRAM_BOT_TOKEN=
ALERTMANAGER_TELEGRAM_CHAT_ID=0         # Telegram chat ID (non-zero integer)
# Email relay for all alerts. _TO and _HOST are both required for email to arm.
ALERTMANAGER_SMTP_FROM=alerts@hopefx.io
# Recipient for alert emails
ALERTMANAGER_SMTP_TO=
ALERTMANAGER_SMTP_HOST=localhost:587    # SMTP relay host:port
# SMTP auth username
ALERTMANAGER_SMTP_USERNAME=
# SMTP auth password
ALERTMANAGER_SMTP_PASSWORD=
# PagerDuty on-call escalation for critical alerts (Events API v2 routing key).
# PagerDuty integration key
ALERTMANAGER_PAGERDUTY_KEY=


# ── Feature flags ─────────────────────────────────────────────────────────────
# Core features — always on in production
FEATURE_COPY_TRADING=true
FEATURE_SOCIAL_FEED=true
FEATURE_LEADERBOARD=true
FEATURE_PROP_FIRM_TRACKER=true
FEATURE_AI_CHAT=true
FEATURE_GRAPHQL=true

# Router-gated features — each controls whether the backend router is registered.
# Disabling a flag returns 404 for that feature's endpoints; the frontend
# degrades gracefully (usePlan defaults to 'free' on 404 from billing).
# Off by default. config/startup_validator.py HARD-FAILS in production when this
# is true and STRIPE_WEBHOOK_SECRET is empty — an unsigned webhook endpoint
# accepts fake payment events, so that check is correct. But shipping the flag on
# means a fresh deploy that is not taking payments yet refuses to start, showing
# only "dependency failed to start: container ... is unhealthy". Stripe is
# configured after the platform is running, so the default has to match that
# order. Set the keys below, flip this to true, restart.
# .env.production.example already defaulted this to false; this copy did not.
FEATURE_BILLING_SUBSCRIPTION=false
FEATURE_WATCHLIST=true
FEATURE_TRADE_JOURNAL=true
FEATURE_TWO_FACTOR_AUTH=true
FEATURE_ADVANCED_TRADING=true
FEATURE_PRICE_ALERTS=true
FEATURE_GRAPHQL_API=false              # Enable GraphQL endpoint at /graphql
FEATURE_LIVE_TRADING=false             # Enable live (non-paper) order execution

# ── Data & Market features ────────────────────────────────────────────────────
FEATURE_MARKET_DATA_STREAMING=true     # /api/stream  — real-time tick/bar streaming
FEATURE_DEPTH_OF_MARKET=true           # /api/dom     — Level 2 order book
FEATURE_TIME_AND_SALES=true            # /api/timesales — time & sales tape
FEATURE_ORDER_FLOW_ANALYSIS=true       # /api/orderflow — order flow profile
FEATURE_ORDER_FLOW_DASHBOARD=true      # /api/dashboard — order flow dashboard
FEATURE_MARKET_SCANNER=true            # /api/scanner — multi-symbol opportunity scanner

# ── Platform features ─────────────────────────────────────────────────────────
FEATURE_RESEARCH=true                  # /api/research — research notebooks
FEATURE_NOCODE=true                    # /api/nocode   — no-code strategy builder
FEATURE_TEAMS=true                     # /api/teams    — team collaboration
FEATURE_REPLAY=true                    # /api/replay   — market replay engine
FEATURE_PUSH_NOTIFICATIONS=true        # /api/alerts   — push notification alerts
FEATURE_TRANSPARENCY=true              # /api/transparency — execution transparency reports
FEATURE_EXPLAINABILITY=true            # /api/explainability — ML model explainability
FEATURE_MOBILE_API=true                # /mobile       — mobile API v2


# =============================================================================
# HOPEFX BRAIN — Security Engine (security/global_fortress.py)
# =============================================================================
# The brain runs 24/7 as a background task. It classifies attack intent via
# an LLM, decides responses via the RL agent, and auto-heals code every 30 min.
#
# ── LLM backend (REQUIRED for real analysis) ─────────────────────────────────
# Select which LLM provider to use. Without a key the brain falls back to a
# safe stub (logs "analysis_unavailable") — trading continues unaffected.
#
# Both the security analysis module and the strategy generation agent read these vars.
# Set ONE provider key — the backend you select must have a valid key.
#
# Options: "anthropic" (default) | "openai"
LLM_BACKEND=anthropic

# Anthropic Claude — https://console.anthropic.com/
#   Used by: security analysis (llm_wrapper) + strategy generation (llm_agent)
#   Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI GPT (used when LLM_BACKEND=openai)
#   Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=o4-mini

# Max tokens for strategy code generation.
LLM_MAX_TOKENS=8192

# Max tokens for security analysis responses.
# Overrides LLM_MAX_TOKENS for the security module only — keep low for cost/latency.
LLM_SECURITY_MAX_TOKENS=1024

# Retry config — applies to both llm_wrapper and llm_agent on transient errors (429/503/529).
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0

# ── Flashpoint threat intelligence (optional) ─────────────────────────────────
# Pulls IOC (indicators of compromise) feeds every 30 s.
# Without a key: Flashpoint sync is silently skipped.
# Get key: https://flashpoint.io/
FLASHPOINT_API_KEY=
FLASHPOINT_API_URL=https://api.flashpoint.io/v1/iocs

# ── ArgoCD rollback webhook (optional) ───────────────────────────────────────
# When HOPEFXBrain triggers a nuclear lockdown it POSTs to this URL to roll
# back the Kubernetes deployment to the last known-good revision.
# Format: https://<argocd-server>/api/v1/applications/hopefx/sync
# Leave empty to disable auto-rollback (lockdown still activates).
ARGOCD_ROLLBACK_WEBHOOK=

# ── Brain tuning ──────────────────────────────────────────────────────────────
# How often the brain scans routes + drains honeypot logs (seconds, default 30)
BRAIN_SCAN_INTERVAL=30
# How often the brain runs auto-heal code review (seconds, default 1800 = 30 min)
BRAIN_HEAL_INTERVAL=1800
# Semantic encoder — disabled by default (requires PyTorch ~1 GB + sentence-transformers)
# Enable only on nodes with sufficient RAM (>=4 GB) and PyTorch already installed.
# The brain classifies attacks via LLM without this — encoder adds similarity scoring only.
BRAIN_SEMANTIC_ENCODER=false


# =============================================================================
# DATA LAYER — Gold Price APIs
# =============================================================================
# At least ONE gold price API key is required for live trading.
# Priority order: GoldAPI.io → Metals.dev → Metals-API → MetalpriceAPI → CommodityPriceAPI
#
# GoldAPI.io — https://www.goldapi.io/
#   Free: 100 req/month | Paid: up to 10,000 req/month
#   Provides bid/ask spread — highest quality source
#   Used by: data_layer/feeds/gold/goldapi.py (GoldAPIFeed)
#   Symbol: XAU  Currency: USD
GOLDAPI_IO_KEY=

# Metals.dev — https://metals.dev/
#   Free: 100 req/month | Paid: up to 100,000 req/month + WebSocket
METALS_DEV_KEY=

# Metals-API — https://metals-api.com/
#   Free: 100 req/month | Paid: up to 50,000 req/month
METALS_API_KEY=

# MetalpriceAPI — https://metalpriceapi.com/
#   Free: 100 req/month | Paid: up to 50,000 req/month
METALPRICEAPI_KEY=

# CommodityPriceAPI — https://commoditypriceapi.com/
#   Free: 100 req/month | Paid: up to 100,000 req/month
COMMODITY_PRICE_API_KEY=


# =============================================================================
# DATA LAYER — World Gold Council (WGC) Demand Data
# =============================================================================
# WGC publishes quarterly gold demand statistics (jewellery, investment,
# central bank, technology) and monthly ETF flow data as free CSV/Excel files.
# No API key is required — data is fetched directly from the WGC public URLs.
#
# WGC data feed: data_layer/feeds/macro/wgc.py (WGCFeed)
# MacroStore series injected:
#   wgc_total_demand    — total gold demand (tonnes, quarterly)
#   wgc_investment      — bar/coin + ETF investment demand (tonnes, quarterly)
#   wgc_central_bank    — central bank net purchases (tonnes, quarterly)
#   wgc_jewellery       — jewellery demand (tonnes, quarterly)
#   wgc_etf_flow        — ETF net flow (tonnes, monthly)
#
# Cache directory for downloaded WGC files (relative to project root)
WGC_CACHE_DIR=data/wgc_cache
# Refresh interval for WGC data (seconds; default 86400 = 24 hours)
WGC_REFRESH_INTERVAL=86400
# WGC quarterly demand CSV URL (override if WGC changes their URL structure)
WGC_DEMAND_URL=https://www.gold.org/goldhub/data/gold-demand-statistics
# WGC ETF flow CSV URL
WGC_ETF_FLOW_URL=https://www.gold.org/goldhub/data/global-gold-backed-etf-holdings-and-flows


# =============================================================================
# DATA LAYER — News & Sentiment APIs
# =============================================================================
# At least ONE news API key is recommended for sentiment features.
# All five can be active simultaneously for maximum coverage.
#
# Finnhub — https://finnhub.io/
#   Free: 60 req/min | Provides native sentiment scores for gold
#   Also used for: economic calendar (MacroCalendarEngine)
#   Also used for: NuclearStreamer live WebSocket ticks (OANDA:XAU_USD)
#   Set FINNHUB_API_KEY in the NuclearStreamer section above — shared key.

# Financial Modeling Prep (FMP) — https://financialmodelingprep.com/
#   Free: 250 req/day | Gold-ticker-tagged news (GLD, IAU, XAUUSD)
FMP_API_KEY=

# NewsData.io — https://newsdata.io/
#   Free: 200 credits/day | Full-text gold search
NEWSDATA_IO_KEY=

# Alpha Vantage — https://www.alphavantage.co/
#   Free: 25 req/day | Pre-scored sentiment + ticker relevance
#   NOTE: ALPHA_VANTAGE_KEY is shared with the existing technical data feed
ALPHA_VANTAGE_KEY=

# NewsAPI.org — https://newsapi.org/
#   Free: 100 req/day (developer plan)
NEWSAPI_ORG_KEY=

# NewsAPI.ai — https://newsapi.ai/ (optional upgrade from NewsAPI.org)
#   Paid only | Richer entity extraction + native sentiment
NEWSAPI_AI_KEY=


# =============================================================================
# DATA LAYER — Macro Data
# =============================================================================
# FRED API key — https://fred.stlouisfed.org/docs/api/api_key.html
#   Free (no credit card required).
#
#   REQUIRED, not optional. With no key, data_layer/feeds/macro/fred.py
#   short-circuits every fetch to an empty series without sending a request, so
#   zero macro data is retrieved. This previously read "Without key: 120 req/day
#   | With key: 500 req/day", which reads as though the key were optional and a
#   keyless quota would still work — it does not, in this codebase.
#
#   With no key the macro pipeline falls back to the bundled CSVs in
#   data/macro/, which are a point-in-time snapshot and go stale — the
#   deployment that prompted this was serving observations 142 days old while
#   reporting itself freshly refreshed.
#
#   Fetches: DXY, US10Y, US2Y, real10Y (TIPS), CPI, PCE, VIX, Fed Funds, M2
FRED_API_KEY=

# Macro observations older than this (days) are treated as stale by
# MacroStoreBridge: health() reports stale=true and consumers can refuse them
# rather than letting a months-old VIX vote on today's regime. Default 7 —
# FRED series are daily, so a week covers a normal publication gap.
MACRO_MAX_AGE_DAYS=7


# =============================================================================
# DATA LAYER — Dukascopy Historical Tick Data
# =============================================================================
# No API key required — Dukascopy provides free public tick data.
# Configure the local cache directory for downloaded bi5 files.
# Default: data/dukascopy_cache (relative to project root)
DUKASCOPY_CACHE_DIR=data/dukascopy_cache


# =============================================================================
# DATA LAYER — Tuning Parameters
# =============================================================================
# Data Quality Engine
DQE_MAX_JUMP_PCT=0.005          # reject ticks that move >0.5% in one tick
DQE_STALE_THRESHOLD_S=30.0      # mark source stale after 30s silence
                                # consensus also excludes ticks older than 2× this value

# ── Sentiment engine ──────────────────────────────────────────────────────────
SENT_MAX_ARTICLE_AGE_H=24.0     # ignore articles older than this (stale news)
SENT_DEDUP_WINDOW_H=6.0         # cross-feed dedup window (same URL = duplicate)

# ── L2 order book (multi-source: Polygon quotes + Finnhub trade tape) ─────────
# L2_PROVIDER: "multi" (default) = Polygon L2 + Finnhub delta collated
#              "polygon"         = Polygon only (quotes + Polygon trade events)
#              "mock"            = synthetic data, blocked in production
L2_PROVIDER=multi
# POLYGON_API_KEY is shared with NuclearStreamer — set it once above
# FINNHUB_API_KEY is shared with NuclearStreamer — optional but improves delta
L2_DEPTH_LEVELS=10              # price levels tracked per side
L2_DEPTH_BPS=50                 # depth window in bps from mid
L2_RECONNECT_INITIAL=1.0        # WebSocket reconnect back-off start (seconds)
L2_RECONNECT_MAX=60.0           # WebSocket reconnect back-off ceiling (seconds)
DQE_LATENCY_WARN_MS=500.0       # warn when source latency >500ms
DQE_ANOMALY_ZSCORE=4.0          # z-score threshold for anomaly detection
DQE_CROSS_SOURCE_MAX_DIFF=0.003 # flag sources >0.3% from consensus
# Redis cache TTLs (seconds)
DL_TICK_TTL_S=30
DL_MICRO_TTL_S=5
DL_SENTIMENT_TTL_S=60
DL_MACRO_TTL_S=300
DL_CALENDAR_TTL_S=60

# Lineage store
LINEAGE_DB_PATH=data/lineage/lineage.db
# LINEAGE_DB_URL: when set, lineage records are written to PostgreSQL instead of
# the local SQLite file.  Use the same host/credentials as DATABASE_URL.
# Format: postgresql+asyncpg://user:password@host:5432/hopefx
# Leave blank to use the local SQLite file (LINEAGE_DB_PATH).
# Optional: postgresql+asyncpg://user:pass@host/db
LINEAGE_DB_URL=
LINEAGE_QUEUE_SIZE=50000                 # In-memory write queue depth
LINEAGE_BATCH_SIZE=500                   # Records per SQLite batch write
LINEAGE_FLUSH_S=2.0                      # Flush interval in seconds
LINEAGE_MAX_RECORDS=5000000              # Max rows before pruning oldest
LINEAGE_PRUNE_INTERVAL=3600             # Prune check interval (seconds)

# Redis cache TTLs (seconds) — additional keys
DL_TICK_HISTORY_MAX=10000               # Max ticks in sorted set history
DL_OHLCV_MAX_BARS=2000                  # Max OHLCV bars per timeframe in Redis
DL_QUALITY_TTL_S=30                     # Quality report cache TTL
DL_HEALTH_TTL_S=10                      # Feed health cache TTL

# Macro data directory (for CSV fallback when FRED is unavailable)
MACRO_DATA_DIR=data/macro

# News blackout windows around high-impact events (minutes)
NEWS_BLACKOUT_BEFORE_MIN=5
NEWS_BLACKOUT_AFTER_MIN=5
NEWS_BLACKOUT_MINUTES=5                 # Alias used by gatekeeper _NewsCalendar

# Macro calendar refresh interval (seconds, default 1 hour)
CALENDAR_REFRESH_S=3600.0

# MacroStoreBridge FRED startup retry
MACRO_BRIDGE_STARTUP_RETRIES=3          # Max FRED load attempts on startup
MACRO_BRIDGE_STARTUP_RETRY_S=5.0       # Base delay between retries (doubles each attempt)

# Microstructure engine
MICRO_WINDOW_TICKS=500                  # Rolling tick window size
MICRO_DELTA_WINDOW=100                  # Buy/sell pressure window
MICRO_PRESSURE_ALPHA=0.10               # Trade pressure EMA alpha
MICRO_SPREAD_ALPHA_F=0.10               # Spread fast EMA alpha
MICRO_SPREAD_ALPHA_S=0.02               # Spread slow EMA alpha
MICRO_VWAP_WINDOW=200                   # VWAP rolling window
MICRO_ZSCORE_WINDOW=100                 # Spread z-score window

# News sentiment engine
SENT_EMA_ALPHA=0.15                     # Sentiment EMA decay factor
SENT_WINDOW_H=1.0                       # Article lookback window (hours)
SENT_MAX_HISTORY=500                    # Max articles in memory
SENT_MIN_RELEVANCE=0.10                 # Minimum gold relevance to include

# Data Quality Engine — additional parameters
DQE_MIN_GOLD_PRICE=500.0               # Sanity floor for gold price (USD)
DQE_MAX_GOLD_PRICE=10000.0             # Sanity ceiling for gold price (USD)
DQE_MAX_SPREAD_PCT=0.01                # Max spread as % of mid (1%)
DQE_WINDOW_SIZE=200                    # Rolling window for anomaly detection
DQE_CONFIDENCE_DECAY=0.95              # Confidence EMA decay on error
DQE_MIN_CONFIDENCE=0.30                # Minimum source confidence floor

# Feed circuit breaker
FEED_CB_OPEN_ERRORS=5                  # Consecutive errors before circuit opens
FEED_CB_HALF_OPEN_S=60.0              # Seconds before half-open probe

# Normalization pipeline
NORM_PRICE_DECIMALS=4                  # Decimal places for price rounding
NORM_MIN_SPREAD=0.01                   # Minimum bid/ask spread (USD)
NORM_MAX_SPREAD_PCT=0.01               # Maximum spread as % of mid
NORM_GAP_MULTIPLIER=3.0               # Gap flag threshold (× rolling mean)
NORM_GAP_WINDOW=20                     # Rolling window for gap detection
NORM_MIN_GOLD_PRICE=100.0             # Drop OHLCV bars below this price

# Market replay engine
REPLAY_DEFAULT_SYMBOL=XAUUSD           # Default Dukascopy symbol
REPLAY_DEFAULT_TF_MIN=60               # Default timeframe in minutes
REPLAY_MAX_DAYS=365                    # Maximum replay range (days)
REPLAY_SPEED=0.0                       # 0=max speed, 1=real-time, N=N× real-time


# =============================================================================
# RISK MANAGEMENT — Extended Parameters
# =============================================================================

# Account and position sizing
RISK_ACCOUNT_EQUITY=100000.0           # Starting account equity (USD)
RISK_MAX_POSITION_PCT=0.05             # Max single position as % of equity
RISK_MIN_POSITION_PCT=0.001            # Minimum position size floor
RISK_MAX_OPEN_POSITIONS=3              # Maximum simultaneous open positions
RISK_MIN_DATA_QUALITY=0.60             # Minimum DQE confidence to allow trade
RISK_DRAWDOWN_MODE=daily               # Drawdown tracking: daily | peak
RISK_VAR_CONFIDENCE=0.95               # VaR confidence level
RISK_VAR_WINDOW=252                    # VaR rolling window (bars)
RISK_ALERT_PCT_OF_LIMIT=0.80           # Alert when drawdown reaches 80% of limit
HOPEFX_VAR_ENFORCE_MULTIDAY=false      # Enforce multi-day VaR limit
RISK_CVAR_DAILY_LIMIT=0.0              # Daily CVaR limit as fraction of equity (0=disabled)

# Position sizing scaling factors (multipliers applied to base size)
RISK_SENT_SIZE_SCALE=0.20              # Sentiment impact on position size (±20%)
RISK_IMPACT_SIZE_SCALE=0.30            # Macro impact scaling (±30%)
RISK_DD_SIZE_SCALE=0.50                # Drawdown scaling (reduce to 50% at max DD)

# Legacy position sizing (used by position_sizing.py)
MAX_RISK_PCT_PER_TRADE=0.01            # Max risk per trade as % of equity (1%)
MAX_POSITION_PCT=0.05                  # Max position size as % of equity
MAX_LOTS=10.0                          # Maximum lot size
MIN_LOTS=0.01                          # Minimum lot size
POSITION_RISK_PCT=0.01                 # Default risk per trade (1%)
POSITION_SIZING_METHOD=kelly           # kelly | fixed | atr
KELLY_FRACTION=0.25                    # Kelly fraction (0.25 = quarter-Kelly)


# =============================================================================
# GATEKEEPER — Trade Gate Parameters
# =============================================================================

GATEKEEPER_MIN_CONF=0.60               # Minimum signal confidence to pass gate
GATEKEEPER_MIN_DATA_QUALITY=0.60       # Minimum DQE tick confidence
GATEKEEPER_MAX_SPREAD_USD=3.0          # Maximum bid/ask spread in USD
GATEKEEPER_MAX_DAILY_TRADES=20         # Daily trade cap (circuit breaker)
GATEKEEPER_PAUSE_S=300.0               # Pause duration after loss streak (seconds)
GATEKEEPER_SENT_BLACKOUT=-0.60         # Block trades when sentiment < this value
GATEKEEPER_IMPACT_BLACKOUT=0.70        # Block trades when macro impact > this value


# =============================================================================
# ML / SIGNAL ENGINE — Extended Parameters
# =============================================================================

# Signal thresholds
SIGNAL_THRESHOLD_LONG=0.60             # Minimum probability to go long
SIGNAL_THRESHOLD_SHORT=0.40            # Maximum probability to go short
SIGNAL_ABSTAIN_HIGH=0.55               # Abstain zone upper bound
SIGNAL_ABSTAIN_LOW=0.45                # Abstain zone lower bound
SIGNAL_HIGH_CONF=0.75                  # High-confidence threshold (full size)
SIGNAL_QUALITY_WINDOW=50               # Rolling window for signal quality metrics
MIN_CONFIDENCE_ABS=0.55                # Absolute minimum confidence to trade

# Expected value filter
EV_MIN_THRESHOLD=0.0                   # Minimum expected value to trade (0 = disabled)
EV_WINDOW=100                          # Rolling window for EV calculation

# Feature engineering
FEATURE_CACHE_TTL_SECONDS=30           # Feature cache TTL for live inference
FEATURE_MTF_FUSION=true                # Enable multi-timeframe feature fusion
FEATURE_ONLINE_LEARNING=false          # Phase 3: gated on a 90-day paper run with >= 500 fills (F214/F215)
MTF_CONFLUENCE_REQUIRED=false          # Require MTF confluence for entry
REGIME_FILTER_ENABLED=true             # Enable regime-conditional filtering

# LSTM model (optional — used when LSTM model file exists)
LSTM_MODEL_PATH=models/lstm_gold.pt    # Path to trained LSTM model
LSTM_SEQ_LEN=64                        # LSTM input sequence length
LSTM_MIN_BARS=128                      # Minimum bars before LSTM activates
LSTM_SIGNAL_ENABLED=true               # Enable LSTM signal layer blending in brain
LSTM_SIGNAL_WEIGHT=0.30                # LSTM weight in ensemble blend (0.0 = disabled)
LSTM_HIGH_CONF=0.80                    # LSTM high-confidence threshold
LSTM_ABSTAIN_HIGH=0.60                 # LSTM abstain zone upper bound
LSTM_ABSTAIN_LOW=0.40                  # LSTM abstain zone lower bound

# Predictor ensemble
PREDICTOR_MIN_BARS=100                 # Minimum bars for predictor activation
PREDICTOR_ADAPTER_BLEND=0.30           # Adapter model blend weight

# Model registry gates
REGISTRY_MIN_OOS_ACC=0.52              # Minimum OOS accuracy to promote model
REGISTRY_MAX_OOS_PVAL=0.05             # Maximum p-value for OOS significance test
REGISTRY_REQUIRE_SHARPE_GATE=true      # Require Sharpe > 0 for promotion


# =============================================================================
# ML PIPELINE — Training and Monitoring
# =============================================================================

ML_MODEL_DIR=models                    # Directory for saved model files
ML_H1_CSV_DIR=data/h1                  # Directory for H1 OHLCV CSV files
ML_SYMBOLS=XAUUSD                      # Comma-separated symbols to train on
ML_FULL_RETRAIN_HOURS=168              # Full retrain interval (hours, default 1 week)
ML_HOURLY_ENABLED=true                 # Enable hourly online learning updates
ML_HOURLY_INTERVAL_SECONDS=3600        # Online learning update interval
MACRO_HISTORY_YEARS=5                  # Years of FRED macro history to fetch

# Model monitor (auto-rollback on degradation)
ML_MONITOR_CHECK_INTERVAL=3600         # Monitor check interval (seconds)
ML_MONITOR_WINDOW_TRADES=50            # Rolling window for performance monitoring
ML_MONITOR_MIN_TRADES=20               # Minimum trades before monitor activates
ML_MONITOR_ROLLBACK_THRESH=0.45        # Rollback if accuracy drops below this


# =============================================================================
# LIVE TRADING SAFETY GATES (Week 1-3 hardening)
# =============================================================================

# ── LIVE_MODE_CONFIRMED: MUST be set to "true" to allow live broker orders ────
# Without this, any non-paper broker connection will BLOCK all order execution.
# This prevents accidental live trading during development/testing.
LIVE_MODE_CONFIRMED=false              # Change to "true" ONLY for intentional live trading

# ── Leverage hard cap ─────────────────────────────────────────────────────────
# Maximum notional-to-equity ratio for any single order.
# Blocks orders that would exceed this leverage (e.g. 10x = 10:1).
MAX_LEVERAGE_RATIO=10.0

# ── Minimum margin buffer before order submission ─────────────────────────────
# Require margin_available / (margin_used + order_notional) >= this ratio.
# 2.0 = 200% buffer (free margin must be twice the projected used margin).
MIN_MARGIN_BUFFER=2.0

# ── SL/TP monitor (background safety task) ────────────────────────────────────
SLTP_POLL_INTERVAL_MS=200              # How often to check SL/TP levels (ms)
SLTP_MAX_RETRIES=3                     # Max broker close retries on SL/TP breach
SLTP_RETRY_DELAY_S=1.0                 # Seconds between retries

# ── Spread spike detector ─────────────────────────────────────────────────────
SPREAD_SPIKE_MULTIPLIER=3.0            # Block orders when spread > 3× EMA baseline
SPREAD_BASELINE_WINDOW=50              # Ticks used for EMA baseline
SPREAD_MIN_TICKS=20                    # Minimum ticks before detection activates
SPREAD_ABS_LIMIT_USD=5.0               # Absolute spread limit (USD) — always blocks


# =============================================================================
# BYBIT CONNECTOR (Week 5 — DMA-like XAUUSDT perpetuals)
# =============================================================================

BYBIT_API_KEY=CHANGE_ME
BYBIT_API_SECRET=CHANGE_ME
BYBIT_SANDBOX=true                     # "true" = testnet (default); "false" = live
BYBIT_DEFAULT_TYPE=linear              # "linear" = USDT-margined perps (XAUUSDT)


# =============================================================================
# IBKR COMEX GOLD FUTURES (GC/NYMEX DMA via IBKR)
# =============================================================================
# To trade COMEX gold futures instead of XAUUSD spot/CFD, set:
#   symbol=GC (or GC=F)  in your order params
# The IBKR broker auto-routes to NYMEX exchange (CONTFUT sec_type).
# No extra config needed — just connect IBKR and use symbol="GC".
#
# Account minimum for GC futures: ~$7,000 initial margin per contract (check IB).
# Contract size: 100 troy oz.  One tick = $10.00.
IBKR_COMEX_SEC_TYPE=CONTFUT            # CONTFUT = continuous front-month (auto-roll)
IBKR_COMEX_EXCHANGE=NYMEX              # NYMEX = CME Group COMEX division


# =============================================================================
# CME COMEX DIRECT FIX (brokers/cme_comex.py)
# =============================================================================
# Direct FIX 4.4 connection to CME Globex via iLink 3.
# Routing priority: FIX → IBKR fallback → paper simulation.
#
# Enable: set CME_ENABLED=true and BROKER_PRIMARY=cme (or keep as secondary).
# CME FIX credentials are issued by CME Group — contact cmegroup.com/trading.
# Without credentials, the connector falls back to IBKR automatically.
#
CME_ENABLED=false                      # true = connect CME at startup
CME_FIX_HOST=127.0.0.1                 # FIX gateway host (co-located: exchange IP)
CME_FIX_PORT=9876                      # FIX gateway port
CME_FIX_SENDER_ID=HOPEFX              # SenderCompID (CME-assigned)
CME_FIX_TARGET_ID=CME                  # TargetCompID
# FIX logon username
CME_FIX_USERNAME=
# FIX logon password
CME_FIX_PASSWORD=
CME_FIX_CONFIG_FILE=fix.cfg            # Path to FIX session config override
# CME clearing account number
CME_ACCOUNT=
CME_IBKR_FALLBACK=true                 # true = fall back to IBKR if FIX unavailable
CME_PAPER_FALLBACK=true                # true = fall back to paper if both unavailable
CME_DEFAULT_CONTRACTS=1                # Default order size in contracts (1 = 100 oz)
CME_LATENCY_WARN_MS=50                 # Log warning if fill latency exceeds N ms


# =============================================================================
# C++ EXECUTION SHIM
# =============================================================================
# Low-latency C++ process that handles FIX 4.4 with no GIL/GC overhead.
# See execution/cpp_shim/README.md for build and deployment instructions.
#
CPP_SHIM_ENABLED=false                 # true = connect shim at startup
CPP_SHIM_ZMQ_CMD_ADDR=tcp://127.0.0.1:6555   # ZMQ PUSH address (orders to shim)
CPP_SHIM_ZMQ_RESP_ADDR=tcp://127.0.0.1:6556  # ZMQ PULL address (fills from shim)
CPP_SHIM_TIMEOUT_MS=5000               # Response timeout (ms)
CPP_SHIM_LATENCY_WARN_US=1000          # Log warning if round-trip exceeds N microseconds
CPP_SHIM_CMD_PORT=6555                 # ZMQ CMD port
CPP_SHIM_RESP_PORT=6556                # ZMQ RESP port


# =============================================================================
# LOW-LATENCY VPS DEPLOYMENT
# =============================================================================
# CPU core assignments for the low-latency overlay.
# See deployment/lowlatency/README.md for setup instructions.
#
TRADING_CORE=2                         # CPU core for trading engine container
CPP_SHIM_CORE=3                        # CPU core for C++ shim container
IRQ_CORE=3                             # CPU core for NIC interrupt affinity
NIC=eth0                               # Network interface name (ip link show)
TRADING_CPUS=2.0                       # Docker CPU quota for trading engine
TRADING_MEM=4G                         # Docker memory limit for trading engine
API_CPUS=1.0                           # Docker CPU quota for API container
API_MEM=2G                             # Docker memory limit for API container


# =============================================================================
# FRONTEND (Vite) — build-time environment variables
# =============================================================================
# These are injected at build time via Vite's import.meta.env.
# In development the Vite dev server proxies /api and /ws to localhost:8000,
# so these vars are only needed when building for a non-standard deployment.
#
# Leave blank to use the default proxy (relative URLs — recommended).
# Set to absolute URLs only when the API and frontend are on different origins.
# These are read at IMAGE BUILD time, not at container start — Vite inlines
# VITE_* into the bundle. docker-compose.yml forwards them as build args, so
# changing one requires a rebuild, not just a restart:
#     docker compose up -d --build app
# VITE_API_URL and VITE_WS_URL are origins with no trailing path; the app
# appends /api and /ws/live itself. VITE_NUCLEAR_WS_URL is a complete URL.
VITE_API_URL=
VITE_WS_URL=
# Complete URL, e.g. wss://api.example.com/ws/nuclear
VITE_NUCLEAR_WS_URL=


# =============================================================================
# APPLICATION IDENTITY
# =============================================================================
APP_NAME=HOPEFX AI Trading
APP_VERSION=1.0.0
# Legacy alias for APP_ENV (set near the top of this file). Keep the two equal.
# Read by cli.py, risk/manager.py, compliance/kyc_provider.py and
# news/geopolitical_risk.py; APP_ENV takes precedence wherever both are read.
ENVIRONMENT=production                 # production | development
DEBUG=false


# =============================================================================
# ADMIN / SUPERUSER
# =============================================================================
# Comma-separated list of user IDs that are granted superadmin access at startup.
ADMIN_USER_IDS=


# =============================================================================
# DATABASE POOL TUNING
# =============================================================================
DB_POOL_SIZE=10                        # SQLAlchemy pool_size
DB_POOL_MAX_OVERFLOW=20                # SQLAlchemy max_overflow
DB_POOL_RECYCLE=3600                   # Connection recycle interval (seconds)
DB_POOL_TIMEOUT=30                     # Pool checkout timeout (seconds)
DB_CONNECT_TIMEOUT=10                  # TCP connect timeout (seconds)
DB_STATEMENT_TIMEOUT_MS=30000          # PostgreSQL statement_timeout (ms)


# =============================================================================
# JWT (legacy alias — only JWT_SECRET_KEY is used as a fallback)
# =============================================================================
# SECURITY_JWT_SECRET (line 24) is the canonical key read by all subsystems.
# JWT_SECRET_KEY is the only accepted fallback alias (auth/jwt.py, auth/service.py,
# api/auth.py, mobile/api.py, mobile/api_v2.py all fall back to JWT_SECRET_KEY).
# JWT_SECRET is no longer read by any module — do not rely on it.
JWT_SECRET_KEY=change-me-in-production-min-32-chars


# =============================================================================
# WEBSOCKET SERVER
# =============================================================================
WS_AUTH_REQUIRED=true                  # Require JWT auth on /ws/live
WS_AUTH_TIMEOUT=5                      # Seconds to authenticate after connect (30s allowed resource exhaustion)
WS_HEARTBEAT_INTERVAL=30               # Seconds between server heartbeats
WS_HEARTBEAT_MISS_LIMIT=3             # Missed heartbeats before disconnect
WS_SEND_TIMEOUT_S=2.0                  # Hard bound on one socket write. A frozen TCP
                                       # window makes send_text block rather than raise,
                                       # so without this one stalled client held the
                                       # shared broadcast loop and every other client
                                       # stopped receiving data (audit S8-01).
# Optional external price feed WebSocket URL
WS_PRICE_FEED_URL=
WS_CHARTBOT_POLL_INTERVAL=5           # Seconds between chart-bot data broadcasts (microstructure, sentiment, risk, equity)


# =============================================================================
# SIGNAL ENGINE
# =============================================================================
SIGNAL_ENGINE_INTERVAL=5              # Seconds between signal generation cycles
SIGNAL_ENGINE_SYMBOLS=XAUUSD,EURUSD   # Comma-separated symbols to trade


# =============================================================================
# PAPER TRADING
# =============================================================================
# Master paper-trading switch used by execution/fix_router.py and core/main_loop.py.
# Set true to route all orders through PaperTradingBroker instead of FIX/OANDA.
# NOTE: api/trading.py uses BROKER_TYPE=paper for the same purpose — set BOTH
# consistently to avoid a split-brain state where one layer is live and the other
# is paper.  The recommended safe default is true until live trading is verified.
# PAPER_TRADING is set earlier in this file (search above for the canonical value).

# Starting balance for the paper broker (used by fix_router.py fallback path).
# Distinct from PAPER_TRADING_BALANCE / PAPER_STARTING_BALANCE which are used
# by the paper broker itself.  All three should be set to the same value.
PAPER_INITIAL_BALANCE=100000.0

PAPER_TRADING_BALANCE=100000.0        # Starting balance for paper trading account
PAPER_STARTING_BALANCE=100000.0       # Alias used by some modules


# =============================================================================
# OANDA BROKER (alternate key names)
# =============================================================================
# DEPRECATED alias for OANDA_API_KEY — use OANDA_API_KEY instead
BROKER_OANDA_TOKEN=
# DEPRECATED alias for OANDA_ACCOUNT_ID — use OANDA_ACCOUNT_ID instead
BROKER_OANDA_ACCOUNT=
BROKER_OANDA_ENVIRONMENT=practice      # DEPRECATED alias for OANDA_ENVIRONMENT — use OANDA_ENVIRONMENT instead


# =============================================================================
# OPENTELEMETRY / DISTRIBUTED TRACING
# =============================================================================
# Required packages (already in requirements.txt):
#   opentelemetry-sdk opentelemetry-api opentelemetry-exporter-otlp-proto-http
#   opentelemetry-instrumentation-fastapi opentelemetry-instrumentation-sqlalchemy
#   opentelemetry-instrumentation-redis opentelemetry-instrumentation-aiohttp-client
#
# Quick dev setup — see spans in stdout without a collector:
#   OTEL_ENABLED=true
#   OTEL_EXPORTER=console
#
# Production setup — send to Jaeger / Grafana Tempo / Honeycomb:
#   OTEL_ENABLED=true
#   OTEL_EXPORTER=otlp
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
