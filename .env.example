FTMO_ACCOUNT_ID=
FTMO_SECRET_KEY=
IBKR_FIX_LOG_PATH=logs/fix/
IBKR_FIX_STORE_PATH=data/fix_store/
OANDA_INSTRUMENTS=XAU_USD,EUR_USD,GBP_USD,USD_JPY
