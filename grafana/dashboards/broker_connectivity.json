{
  "title": "HOPEFX — Broker Connectivity",
  "uid": "hopefx-brokers",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Broker Status",
      "type": "table",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "hopefx_broker_connected{broker=~\".+\"}",
          "legendFormat": "{{broker}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DISCONNECTED", "color": "red" }, "1": { "text": "CONNECTED", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Order Round-Trip Latency by Broker (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, rate(hopefx_broker_latency_ms_bucket[5m]))",
          "legendFormat": "{{broker}} p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 3,
      "title": "Order Rejection Rate by Broker",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(hopefx_broker_rejections_total[5m])",
          "legendFormat": "{{broker}} rejections/s"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active Broker (Smart Router Selection)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "hopefx_smart_router_active_broker",
          "legendFormat": "Active Broker"
        }
      ]
    },
    {
      "id": 5,
      "title": "Failover Events (last 24h)",
      "type": "stat",
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "increase(hopefx_broker_failover_total[24h])",
          "legendFormat": "Failovers"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "FIX Session Heartbeat Age (s)",
      "type": "stat",
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "time() - hopefx_fix_last_heartbeat_timestamp",
          "legendFormat": "FIX heartbeat age"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 30 }
            ]
          }
        }
      }
    }
  ]
}
