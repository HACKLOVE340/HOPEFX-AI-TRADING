{
  "title": "HOPEFX — ML Model Metrics",
  "uid": "hopefx-ml",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Signal Confidence Distribution",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, rate(hopefx_signal_confidence_bucket[1h]))",
          "legendFormat": "p95 confidence"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, rate(hopefx_signal_confidence_bucket[1h]))",
          "legendFormat": "p50 confidence"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "id": 2,
      "title": "Signals Generated per Hour",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(hopefx_signals_total[1h])",
          "legendFormat": "{{direction}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Model Prediction Accuracy (rolling 24h)",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 6, "w": 6, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "hopefx_model_accuracy_pct",
          "legendFormat": "Accuracy"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 55 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Current Market Regime",
      "type": "stat",
      "gridPos": { "x": 6, "y": 6, "w": 6, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "hopefx_market_regime",
          "legendFormat": "Regime"
        }
      ]
    },
    {
      "id": 5,
      "title": "Feature Drift Score",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "hopefx_feature_drift_score",
          "legendFormat": "Drift"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 0.6 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Model Inference Latency (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, rate(hopefx_model_inference_ms_bucket[5m]))",
          "legendFormat": "p95 ms"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 7,
      "title": "Last Model Retrain",
      "type": "stat",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "time() - hopefx_model_last_trained_timestamp",
          "legendFormat": "Seconds since retrain"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
