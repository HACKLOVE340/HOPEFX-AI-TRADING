# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hopefx
DB_USER=hopefx
DB_PASSWORD=your_secure_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security (generate with: openssl rand -hex 32)
SECURITY_ENCRYPTION_KEY=your_64_char_hex_key_here
SECURITY_SALT=your_32_char_hex_salt_here
SECURITY_JWT_SECRET=your_jwt_secret_here_32_chars_min

# Brokers
BROKER_DEFAULT=paper
BROKER_OANDA_TOKEN=
BROKER_OANDA_ACCOUNT=
BROKER_OANDA_ENVIRONMENT=practice
# How often (seconds) to poll OANDA for live bid/ask prices
OANDA_POLL_INTERVAL=1.0

# Real-time price feed URLs (optional — leave blank to use broker REST polling)
# WebSocket feed: e.g. wss://stream-fxtrade.oanda.com/v3/accounts/{id}/pricing/stream
WS_PRICE_FEED_URL=
# REST feed: e.g. https://api-fxpractice.oanda.com
REST_PRICE_FEED_URL=

# Risk
RISK_MAX_DAILY_LOSS_PCT=2.0
RISK_MAX_POSITION_SIZE_PCT=5.0
RISK_MAX_DRAWDOWN_PCT=10.0
RISK_KILL_SWITCH_ENABLED=true
# CVaR (Expected Shortfall) daily limit as a fraction of portfolio value.
# Trading halts for 24 h when the rolling 95th-percentile tail loss exceeds
# this threshold.  Default: 0.02 (2%).  Set to 0 to disable (not recommended).
RISK_CVAR_DAILY_LIMIT=0.02

# Order rate limiting (per authenticated user, sliding window)
ORDER_RATE_LIMIT=10
ORDER_RATE_WINDOW=60

# ML
ML_MODEL_PATH=./models
ML_RETRAIN_INTERVAL_HOURS=24

# Email notifications (SMTP)
# Leave blank to disable email alerts; Telegram works independently.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@yourdomain.com
# Comma-separated list of recipient addresses
SMTP_TO=admin@yourdomain.com

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord notifications
DISCORD_WEBHOOK_URL=

# Stripe (required for marketplace)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend (Vite) — set in dashboard/.env or pass as build args
# Leave blank to use relative URL derived from window.location (works behind any proxy)
VITE_WS_URL=
# Example for local dev: VITE_WS_URL=ws://localhost:8000/ws
# Example for production: VITE_WS_URL=wss://yourdomain.com/ws
