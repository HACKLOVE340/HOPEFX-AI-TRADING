# =============================================================================
# HOPEFX Frontend — Vite environment variables
# =============================================================================
# Copy this file to .env.local and fill in values for your deployment.
# In development the Vite dev server proxies /api and /ws to localhost:8000,
# so all three variables below can be left blank.
#
# Set them only when the frontend and backend are on different origins
# (e.g. a CDN-hosted SPA talking to a separate API domain).
#
# All variables must be prefixed with VITE_ to be exposed to the browser.
# =============================================================================

# REST API base URL.
# Default (blank): relative /api — proxied to http://localhost:8000 in dev,
# served from the same origin in production (Nginx reverse-proxy).
# Override example: https://api.yourdomain.com
VITE_API_URL=

# Live-price WebSocket URL (/ws/live).
# Default (blank): relative /ws/live — proxied to ws://localhost:8000 in dev.
# Override example: wss://api.yourdomain.com
VITE_WS_URL=

# Nuclear chart-bot WebSocket URL (/ws/nuclear).
# Default (blank): relative /ws/nuclear — proxied to ws://localhost:8000 in dev.
# Override example: wss://api.yourdomain.com
VITE_NUCLEAR_WS_URL=
