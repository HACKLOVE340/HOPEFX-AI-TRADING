# =============================================================================
# HOPEFX Frontend — Vite environment variables
# =============================================================================
# Copy this file to .env.local and fill in values for your deployment.
#
# DEVELOPMENT (default — leave all blank):
#   The Vite dev server proxies /api, /ws, /nuclear, /nuclear-strategy,
#   /tca, /kyc, /graphql to http://localhost:8000 automatically.
#   All three VITE_ vars below can be left empty.
#
# PRODUCTION — same origin (recommended, Docker / VPS):
#   The React bundle is served by FastAPI from /static/ on the same domain.
#   Nginx proxies /api/* and /ws/* to the backend on the same origin.
#   Leave all three VITE_ vars blank — relative URLs work automatically.
#
# PRODUCTION — split origin (CDN SPA + separate API domain):
#   Set all three VITE_ vars to your API domain so the browser knows where
#   to send requests. The API domain must be in ALLOWED_ORIGINS in .env.
#
# All variables MUST be prefixed with VITE_ to be exposed to the browser.
# =============================================================================

# REST API base URL.
# Default (blank): relative /api — works for same-origin deployments.
# Split-origin example: https://api.yourdomain.com
VITE_API_URL=

# Live-price WebSocket URL (/ws/live).
# Default (blank): auto-detected from window.location (ws:// or wss://).
# Split-origin example: wss://api.yourdomain.com
VITE_WS_URL=

# Nuclear chart-bot WebSocket URL (/ws/nuclear).
# Default (blank): auto-detected from window.location (ws:// or wss://).
# Split-origin example: wss://api.yourdomain.com
VITE_NUCLEAR_WS_URL=
