[MAIN]
# Add the project root to sys.path so deferred imports resolve correctly.
init-hook='import sys; sys.path.insert(0, ".")'

# Use multiple processes for speed.
jobs=0

[MESSAGES CONTROL]
# Disable categories/checks that are either false positives in this codebase
# or intentionally suppressed project-wide.
disable=
    # Import errors for internal modules resolved at runtime (not at lint time).
    import-error,
    # Dynamic attribute access on SQLAlchemy / ORM objects.
    no-member,
    # Codacy/Pylint style checks not enforced here.
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-few-public-methods,
    too-many-arguments,
    too-many-instance-attributes,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-return-statements,
    too-many-public-methods,
    fixme,
    line-too-long,
    invalid-name,
    duplicate-code,
    # W0718: broad-exception-caught — catching Exception is acceptable in top-level
    # handlers and async tasks where we log and re-raise or degrade gracefully.
    broad-exception-caught,
    # W1203: logging-fstring-interpolation — f-strings in logging are intentional
    # for readability; lazy % formatting is not enforced project-wide.
    logging-fstring-interpolation,
    # W0212: protected-access — internal helpers and tests legitimately access
    # private attributes of sibling classes.
    protected-access,
    # W0621: redefined-outer-name — pytest fixtures shadow outer names by design.
    redefined-outer-name,
    # W0613: unused-argument — many callback/interface methods accept arguments
    # they do not use (e.g. event handlers, abstract overrides).
    unused-argument,
    # W0603: global-statement — module-level singletons use global intentionally.
    global-statement,
    # W0201: attribute-defined-outside-init — SQLAlchemy mapped classes and
    # dataclass-like patterns define attributes outside __init__.
    attribute-defined-outside-init,
    # W0602: global-variable-not-assigned — read-only global references are valid.
    global-variable-not-assigned,
    # W0108: unnecessary-lambda — some lambdas are kept for explicit readability.
    unnecessary-lambda,
    # W0105: pointless-string-statement — module-level string literals used as
    # section separators or informal documentation.
    pointless-string-statement,
    # C0415: import-outside-toplevel — deferred imports inside functions are
    # intentional throughout this codebase for optional/heavy dependencies and
    # circular-import avoidance.
    import-outside-toplevel,
    # C0413: wrong-import-position — some modules have conditional imports after
    # try/except blocks or after module-level constants; accepted project-wide.
    wrong-import-position,
    # C0411: wrong-import-order — import ordering is enforced by ruff/isort in
    # CI; pylint's ordering check is redundant and produces false positives.
    wrong-import-order,
    # W0404: reimported — re-imports inside functions are intentional for
    # deferred loading; top-level re-imports are caught by ruff F811.
    reimported,
    # R0917: too-many-positional-arguments — covered by too-many-arguments above.
    too-many-positional-arguments,
    # C0302: too-many-lines — large API modules are intentional; splitting would
    # break the router registration pattern used throughout.
    too-many-lines,
    # W0707: raise-missing-from — not enforced project-wide; many raise sites
    # intentionally suppress the original exception for cleaner user messages.
    raise-missing-from,
    # W1514: unspecified-encoding — open() calls without encoding are acceptable
    # when reading binary or platform-default text files.
    unspecified-encoding,
    # C0206: consider-using-dict-items — stylistic; not enforced.
    consider-using-dict-items,
    # C0200: consider-using-enumerate — stylistic; not enforced.
    consider-using-enumerate,
    # R1702: too-many-nested-blocks — complex parsing/validation logic requires
    # nesting; refactoring would reduce readability.
    too-many-nested-blocks,
    # W0611: unused-import — caught by ruff F401 in CI; pylint check is redundant.
    unused-import

[FORMAT]
max-line-length=120

[DESIGN]
max-args=10
max-attributes=15
